{
  "name": "neil-tayler-editorial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "images": "node scripts/prepare-images.mjs",
    "predev": "npm run images",
    "prebuild": "npm run images",
    "precheck": "npm run images",
    "dev": "astro dev --host 127.0.0.1 --background",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "format": "prettier --write src scripts tests astro.config.ts package.json tsconfig.json README.md .github/workflows/deploy.yml",
    "format:check": "prettier --check src scripts tests astro.config.ts package.json tsconfig.json README.md .github/workflows/deploy.yml",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "postbuild": "node scripts/finish-build.mjs",
    "photos:upload": "node scripts/upload-photos.mjs",
    "photos:check": "node scripts/upload-photos.mjs --check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "astro": "7.3.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
