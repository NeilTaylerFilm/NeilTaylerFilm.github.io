---
// src/layouts/BlogPost.astro
// The layout for an individual blog post
import { Image } from 'astro:assets';
import { format } from 'date-fns';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { SITE_URL } from '../consts';

const { title, subtitle, date, category, image, draft } = Astro.props;

// If draft, we don't show the post (but we should filter out drafts in the query)
// However, we are passing only published posts, so we can ignore draft here.

// Format date as YYYY-MM-DD
const formattedDate = format(date, 'yyyy-MM-dd');

// Determine the image to use
let imageSrc = null;
let imageAlt = '';
if (image) {
  // Assuming image is a string path relative to src/ (without leading slash)
  // We'll pass it directly to the Image component from astro:assets
  imageSrc = image; // This is the relative path from src/
  imageAlt = `${title} featured image`;
}

// Render the content
const { Content } = await render(Astro.props);
---

<article class="blog-post">
  <header class="blog-post-header mb-8">
    <div class="flex flex-wrap items-baseline gap-4 mb-4 text-sm text-muted">
      <span class="category-tag bg-bg-accent text-accent px-2 py-0.5 rounded">{category}</span>
      <span class="date">{formattedDate}</span>
    </div>
    <h1 class="text-4xl font-bold mb-4">{title}</h1>
    {subtitle && <p class="text-2xl font-medium text-fg mb-6">{subtitle}</p>}
    {imageSrc && (
      <figure class="mb-6">
        <Image src={imageSrc} alt={imageAlt} class="rounded-lg w-full h-auto object-cover" />
        {/*
          We could add a caption here if we had one in the frontmatter, but we don't.
          We'll leave it for future enhancement.
        */}
      </figure>
    )}
  </header>
  <div class="prose prose-lg mx-auto">
    <Content />
  </div>
</article>

<style>
  /* Style for the category tag */
  .category-tag {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Style for the prose content */
  .prose {
    /* We'll use the default prose styles from our global.css, but we can adjust if needed */
    max-width: 36rem; /* 576px */
  }

  /* Make images in the prose content responsive and full width */
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  /* Style for the header */
  .blog-post-header {
    text-align: center;
  }

  /* Center the category and date on larger screens */
  @media (min-width: 640px) {
    .blog-post-header .flex {
      justify-content: center;
    }
  }
</style>