---
// ==========================================
// 🏛️ THE MASTER HOUSE BLUEPRINT (Base Layout)
// ==========================================
// Think of this file like the foundation and walls of your house!
// Every page on your website (Home, About, Blog, Photography) sits inside
// this blueprint. It gives every page:
// 1. The top navigation bar (<Header />)
// 2. The main living room content (<slot />)
// 3. The bottom footer (<Footer />)
// 4. Instant dark/light mode so screens never flicker white!

// Base layout: Header, main slot, Footer, theme script, SEO, and Cloudflare analytics.
// --- BORROWED TOOLS (Imports) ---
// global.css: The master style rules for colors, fonts, margins, and dark mode themes.
import '../styles/global.css';
// Header: The site-wide navigation bar at the top with logo and links.
import Header from '../components/Header.astro';
// Footer: The bottom footer containing copyright and links.
import Footer from '../components/Footer.astro';
// SEO: The search engine tag generator (Meta tags, Open Graph, Twitter cards).
import SEO from '../components/SEO.astro';

// What every page can tell this layout:
// This interface is like an order form specifying what options each page can customize.
interface Props {
  title: string;        // Page title
  description?: string; // Summary description
  image?: string;       // Social sharing card image
  article?: boolean;    // Is it a blog article?
  noindex?: boolean;    // Should Google ignore this page?
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* ⚡ ANTI-FLASH SCRIPT:
        Runs instantly before the screen paints pixels.
        If user likes dark mode, sets it immediately so they don't get flashed with white light! */}
    <script is:inline>
      let theme;
      try {
        theme = localStorage.getItem('neil-theme');
      } catch {}
      document.documentElement.dataset.theme =
        theme === 'light' || theme === 'dark'
          ? theme
          : matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
    </script>
    <meta name="color-scheme" content="dark light" />

    {/* 📌 Browser tab icons (Favicons) */}
    {/* Favicons: Small icons displayed in the browser tab and home screen bookmarks. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* 🔍 SEO and Social Sharing Tags */}
    {/* Injects OpenGraph and Twitter meta tags so links look beautiful when shared. */}
    <SEO {...Astro.props} />
    {/* 🚪 Custom slot for any extra head tags requested by individual pages */}
    {/* Slot for extra <head> items like article JSON-LD structured data. */}
    <slot name="head" />
  </head>
  <body>
    {/* ♿ Accessibility skip link so keyboard users can jump straight to main content */}
    {/* Hidden jump link allowing screen-reader and keyboard users to skip the header navigation. */}
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    {/* 🧭 The top navigation menu bar */}
    {/* The site navigation header with logo and primary section links. */}
    <Header />

    {/* 🛋️ The living room: Where each specific page inserts its content! */}
    {/* Main content area: The <slot /> is where each page's specific body template is rendered. */}
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>

    {/* 🦶 The footer at the bottom of the page */}
    {/* The site-wide footer with copyright and theme toggle. */}
    <Footer />

    {/* 📊 Cloudflare Web Analytics: Privacy-friendly visitor counter */}
    {/* Privacy-respecting web analytics powered by Cloudflare Insights. */}
    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "065a237c15724e3986e808592ee3cc38"}'
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>

<script>
  // 🔙 SMART BACK BUTTON:
  // When visitor clicks "Back to blog" or "Back to photography", this preserves
  // whatever category filters or sorting they had picked earlier!
  // The archive URL survives an explicit “Back to blog” link as well as browser Back.
  // Scans all back links and restores previously saved filter/sort state from sessionStorage.
  document.querySelectorAll<HTMLAnchorElement>('[data-archive-back]').forEach((link) => {
    const archive = link.dataset.archiveBack!;
    try {
      const saved = sessionStorage.getItem(`archive:${archive}`);
      if (saved) {
        const url = new URL(saved, location.origin);
        if (url.origin === location.origin && url.pathname === archive) link.href = url.href;
      }
    } catch {}
  });
</script>

