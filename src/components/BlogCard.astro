---
// ==========================================
// 📰 BLOG TEASER CARD (Article Preview Box)
// ==========================================
// Think of this like a handsome little postcard for one blog post!
// It shows the cover picture, title, category, date, a short preview, and an index number.

// --- BORROWED TOOLS (Imports) ---
// CollectionEntry: TypeScript type describing a blog post's data structure.
import type { CollectionEntry } from 'astro:content';
// ResponsiveImage: Picture frame component that serves the right image size.
import ResponsiveImage from './ResponsiveImage.astro';
// excerpt, isoDate, categoryKey: Helper tools to trim summaries, format dates, and normalize categories.
import { excerpt, isoDate, categoryKey } from '../lib/content';
import { displayLabel } from '../lib/feed';

// 📋 What this card needs to build itself:
// Requires the blog post object and its index number in the list.
interface Props {
  // The blog post content from your markdown files
  post: CollectionEntry<'blog'>;
  // Where this card sits in the list (0, 1, 2...)
  index: number;
}

// Unpack props: post content and sequence number
const { post, index } = Astro.props;
const { data } = post;
// Web address to read the full article
const url = `/blog/${post.id}/`;
// A dedicated cover wins; older posts can keep using the original `image` field.
const coverImage = data.coverImage || data.image;
// Type pill + first category shown in the metadata row
const label = displayLabel(data);
---

{/* 📦 The outer card container with data attributes for filtering & sorting */}
{/* HTML data attributes store category keys and publication timestamp for live client filtering */}
<article
  class:list={['blog-card', { 'has-image': coverImage }]}
  data-feed-item
  data-categories={JSON.stringify(data.categories.map(categoryKey))}
  data-date={data.date.getTime()}
  data-id={post.id}
>
  {/* 🖼️ Optional cover picture */}
  {/* If an article image exists, render clickable preview picture */}
  {coverImage && (
    <a class="card-image" href={url} tabindex="-1" aria-hidden="true">
      {/* Load the very first photo immediately so it appears instantly; lazy-load the rest! */}
      <ResponsiveImage
        src={coverImage}
        alt=""
        sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1440px) 32vw, 420px"
        loading={index === 0 ? 'eager' : 'lazy'}
        priority={index === 0}
      />
    </a>
  )}

  <div class="card-content">
    {/* 🏷️ Category tags, date stamp, and optional demo badge */}
    {/* Displays formatted categories and publication date */}
    <div class="metadata">
      {label.type && <span class="type-pill">{label.type}</span>}
      {label.category && <span class="category">{label.category}</span>}
      <time datetime={isoDate(data.date)}>{isoDate(data.date)}</time>
      {data.demo && <span class="demo-tag">Example</span>}
    </div>

    {/* 📰 Article Headline Title */}
    {/* Clickable article title linked to the reading page */}
    <h2>
      <a href={url}>{data.title}</a>
    </h2>

    {/* 📝 Optional subtitle */}
    {data.subtitle && <p class="card-subtitle">{data.subtitle}</p>}

    {/* A custom summary is used when present; otherwise show up to two opening sentences. */}
    <p class="excerpt">{excerpt(post.body, data.excerpt || data.description)}</p>
  </div>

  {/* 🔢 Card numbering badge (e.g. "01", "02") */}
  {/* Formats sequence number like '01' or '02' with padding */}
  <span class="item-number mono" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </span>
</article>

