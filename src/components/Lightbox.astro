---
import PhotoViewer from './PhotoViewer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<PhotoViewer label={`${title} — photographs`} projectLinks={false} />

<script>
  import { createPhotoViewer } from '../scripts/photo-viewer.ts';

  const dialog = document.querySelector<HTMLDialogElement>('[data-portfolio-dialog]');

  if (dialog) {
    document.querySelectorAll<HTMLImageElement>('[data-project-prose] img').forEach((img) => {
      if (img.closest('a')) return;

      const link = document.createElement('a');
      const full = img.dataset.fullImage || img.src;

      link.href = full;
      link.dataset.full = full;
      link.dataset.galleryTrigger = '';

      link.dataset.caption = img.closest('figure')?.querySelector('figcaption')?.textContent || '';

      link.setAttribute(
        'aria-label',
        img.alt ? `Enlarge photograph: ${img.alt}` : 'Enlarge photograph',
      );

      img.before(link);
      link.append(img);
    });

    const triggers = () =>
      Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery-trigger]'));

    const viewer = createPhotoViewer(dialog, triggers);

    triggers().forEach((trigger) => {
      viewer?.bind(trigger, { space: true });
    });
  }
</script>
