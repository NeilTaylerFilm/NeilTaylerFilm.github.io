---
import { imageInfo } from '../lib/images';
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
}
const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  loading = 'lazy',
  priority = false,
} = Astro.props;
const info = imageInfo(src);
if (!info && (!width || !height))
  throw new Error(`Image needs a local source or explicit dimensions: ${src}`);
---

<picture>
  {info && <source type="image/webp" srcset={info.srcset} sizes={sizes} />}
  <img
    src={info?.src || src}
    alt={alt}
    width={info?.width || width}
    height={info?.height || height}
    srcset={info?.fallbackSrcset}
    sizes={info ? sizes : undefined}
    loading={loading}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>
