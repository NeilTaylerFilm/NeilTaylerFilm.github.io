---
// ==========================================
// 🖼️ SMART PICTURE FRAME (Responsive Images)
// ==========================================
// A phone shouldn't download the same gigantic image file as a 30-inch computer screen!
// This component automatically picks the perfect picture size for the visitor's screen.
// It also stops the page from jumping around while images load (by setting width and height).

// --- BORROWED TOOLS (Imports) ---
// imageInfo: Looks up pre-generated responsive image sizes (thumbnails, phone, desktop sizes) in src/lib/images.ts.
import { imageInfo } from '../lib/images';

// 📋 What we need to display a photo:
// Like an instruction slip telling the picture framer how big the photo is and how to hang it.
interface Props {
  // Image web link or local file path
  src: string;
  // Description for accessibility
  alt: string;
  // Explicit pixel width (if known)
  width?: number;
  // Explicit pixel height (if known)
  height?: number;
  // Screen size rules (e.g. "100vw")
  sizes?: string;
  // 'lazy' waits until visitor scrolls near it; 'eager' loads immediately
  loading?: 'eager' | 'lazy';
  // Should the browser give this image top download priority?
  priority?: boolean;
}

// Unpack parameters and set sensible default settings
const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  loading = 'lazy',
  priority = false,
} = Astro.props;

// 🔍 Check our Image Rolodex to find pre-built small, medium, and large versions
// Retrieves srcset links and dimensions so browsers know how much space to reserve.
const info = imageInfo(src);

// If we don't know the image dimensions, throw a helpful safety error
// Prevents Cumulative Layout Shift (CLS) where content jumps around unexpectedly.
if (!info && (!width || !height))
  throw new Error(`Image needs a local source or explicit dimensions: ${src}`);
---

{/* 🖼️ The HTML5 <picture> element lets the browser pick the best version */}
<picture>
  {/* ⚡ High-speed modern WebP format for fast loading */}
  {/* Modern browsers pick from this list of compressed WebP pictures based on screen width */}
  {info && <source type="image/webp" srcset={info.srcset} sizes={sizes} />}

  {/* 📸 Standard fallback image element */}
  {/* decoding="async" allows the browser to decode the image in the background without stuttering scrolling */}
  <img
    src={info?.src || src}
    alt={alt}
    width={info?.width || width}
    height={info?.height || height}
    srcset={info?.fallbackSrcset}
    sizes={info ? sizes : undefined}
    loading={loading}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>

