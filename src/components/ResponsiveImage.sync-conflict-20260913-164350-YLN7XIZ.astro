---
import { imageInfo } from '../lib/images';
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
}
const {
  src,
  alt,
  width = 1600,
  height = 1067,
  sizes = '100vw',
  loading = 'lazy',
  priority = false,
} = Astro.props;
const info = imageInfo(src);
---

<img
  src={src}
  alt={alt}
  width={info?.width || width}
  height={info?.height || height}
  srcset={info?.srcset}
  sizes={info?.srcset ? sizes : undefined}
  loading={loading}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
/>
