---
import ResponsiveImage from './ResponsiveImage.astro';
import { imageInfo } from '../lib/images';
interface Props {
  images: { src: string; alt?: string; caption?: string; width?: number; height?: number }[];
}
const { images } = Astro.props;
---

<div class="gallery">
  {images.map((image, index) => {
    const info = imageInfo(image.src);
    return (
      <figure
        class:list={[
          'gallery-item',
          { portrait: (info?.height || image.height || 0) > (info?.width || image.width || 0) },
        ]}
      >
        <a
          href={info?.full || image.src}
          data-gallery-trigger
          data-caption={image.caption || ''}
          aria-label={image.alt ? `Enlarge photograph: ${image.alt}` : 'Enlarge photograph'}
        >
          <ResponsiveImage
            {...image}
            alt={image.alt || ''}
            sizes={
              index % 3 === 0 ? '(max-width: 1440px) 90vw, 1248px' : '(max-width: 540px) 90vw, 45vw'
            }
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </a>
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    );
  })}
</div>
