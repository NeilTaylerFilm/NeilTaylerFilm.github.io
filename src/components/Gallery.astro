---
// ==========================================
// 🏛️ THE PHOTO WALL GALLERY (Editorial & Mosaic Layouts)
// ==========================================
// This component arranges a collection of photographs into a stunning wall!
// - It automatically splits photos into chapters if you gave them section headings.
// - It calculates whether photos are tall (portrait) or wide (landscape) so they fit together like puzzle pieces.
// - Supports two modes: 'editorial' (big hero shots and pairs) or 'justified' (neat interlocking mosaic rows).

// --- BORROWED TOOLS (Imports) ---
// ResponsiveImage: Smart picture frame that loads optimized images.
import ResponsiveImage from './ResponsiveImage.astro';
// imageInfo: Helper to find dimensions, aspect ratios, and WebP srcsets.
import { imageInfo } from '../lib/images';
// gallerySections: Organizes photo lists into grouped chapters based on markdown headings.
import { gallerySections } from '../lib/gallery-sections';
import { youtubeThumbnailUrl, youtubeWatchUrl } from '../lib/youtube';

type GalleryPhoto = {
  type?: 'photo';
  src: string;
  section?: string;
  full?: string;
  alt?: string;
  caption?: string;
  width?: number;
  height?: number;
};

type GalleryVideo = {
  type: 'video';
  videoId: string;
  poster?: string;
  title?: string;
  section?: string;
  alt?: string;
  caption?: string;
  width?: number;
  height?: number;
};

// 📋 What this gallery accepts:
// An array of photograph objects and an optional layout design choice.
interface Props {
  images: (GalleryPhoto | GalleryVideo)[];
  // The display style
  layout?: 'editorial' | 'justified';
}

// Unpack props: image collection and layout style
const { images, layout = 'editorial' } = Astro.props;
---

{/* 📖 Loop through each chapter section created by our chapter helper */}
{gallerySections(images).map((group) => (
  <Fragment>
    {/* 🏷️ Chapter Title Heading (if this group has one) */}
    {group.heading && <h2 class="gallery-section-heading">{group.heading}</h2>}

    {/* 🧱 Grid of photos */}
    {/* The container for photos. Switches to flex-wrap if layout is justified. */}
    <div
      class:list={['gallery', { 'gallery-justified': layout === 'justified' }]}
      data-justified-gallery={layout === 'justified' ? '' : undefined}
    >
      {group.images.map((image, localIndex) => {
        const index = group.start + localIndex;
        const isVideo = image.type === 'video';
        const previewSource = isVideo
          ? image.poster || youtubeThumbnailUrl(image.videoId)
          : image.src;
        const info = imageInfo(previewSource);

        // 📐 Calculate the aspect ratio (width divided by height) so rows don't distort
        // Ratio calculation: prevents image jumping and controls mosaic expansion
        const ratio = isVideo
          ? (image.width || info?.width || 16) / (image.height || info?.height || 9)
          : (info?.width || image.width || 1) / (info?.height || image.height || 1);
        const full = !isVideo ? image.full || info?.full || image.src : undefined;
        const thumbnailWidth = image.width || info?.width || Math.round(480 * ratio);
        const thumbnailHeight = image.height || info?.height || 480;
        const label = isVideo
          ? `Play video${image.title ? `: ${image.title}` : image.alt ? `: ${image.alt}` : image.caption ? `: ${image.caption}` : ''}`
          : image.alt
            ? `Enlarge photograph: ${image.alt}`
            : 'Enlarge photograph';
        // A complete row can reach 1.25 times its target height.
        const tileSizes = [
          `(max-width: 359px) min(${Math.ceil(ratio * 237.5)}px, calc(100vw - 32px))`,
          `(max-width: 587px) min(${Math.ceil(ratio * 237.5)}px, calc(100vw - 40px))`,
          `(max-width: 767px) min(${Math.ceil(ratio * 312.5)}px, calc(100vw - 48px))`,
          `(max-width: 963px) min(${Math.ceil(ratio * 312.5)}px, calc(100vw - 64px))`,
          `(max-width: 1050px) min(${Math.ceil(ratio * 362.5)}px, calc(100vw - 64px))`,
          `(max-width: 1343px) min(${Math.ceil(ratio * 362.5)}px, calc(100vw - 96px))`,
          `${Math.ceil(Math.min(ratio * 362.5, 1248))}px`,
        ].join(', ');

        return (
          <figure
            style={isVideo || layout === 'justified' ? `--ratio: ${ratio}` : undefined}
            class:list={['gallery-item', { 'gallery-item--video': isVideo, portrait: ratio < 1 }]}
          >
            {/* 🔍 Clickable link that triggers the full-screen Lightbox zoom */}
            {/* High-resolution zoom target passed to the Lightbox popover */}
            <a
              href={isVideo ? youtubeWatchUrl(image.videoId) : full!}
              data-gallery-trigger
              data-media-type={isVideo ? 'video' : 'photo'}
              data-video-id={isVideo ? image.videoId : undefined}
              data-ratio={ratio}
              data-title={isVideo ? image.title || undefined : undefined}
              data-alt={image.alt || undefined}
              data-full={full}
              data-srcset={!isVideo && !image.full ? info?.srcset : undefined}
              data-caption={image.caption || undefined}
              aria-label={label}
            >
              {isVideo ? (
                <>
                  {image.poster ? (
                    <ResponsiveImage
                      src={image.poster}
                      width={thumbnailWidth}
                      height={thumbnailHeight}
                      alt=""
                      sizes={
                        layout === 'justified'
                          ? `${index === 0 ? '' : 'auto, '}${tileSizes}`
                          : '(max-width: 540px) 90vw, 45vw'
                      }
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <img
                      src={previewSource}
                      alt=""
                      width={thumbnailWidth}
                      height={thumbnailHeight}
                      loading={index === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  )}
                  <span class="gallery-video-play" aria-hidden="true">
                    ▶
                  </span>
                </>
              ) : (
                <ResponsiveImage
                  src={image.src}
                  width={image.width}
                  height={image.height}
                  alt={image.alt || ''}
                  sizes={
                    layout === 'justified'
                      ? `${index === 0 ? '' : 'auto, '}${tileSizes}`
                      : index % 3 === 0
                        ? '(max-width: 1440px) 90vw, 1248px'
                        : '(max-width: 540px) 90vw, 45vw'
                  }
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              )}
            </a>
            {/* 📝 Photo caption underneath */}
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        );
      })}
    </div>
  </Fragment>
))}

{/* 🎨 CSS Styles that make justified interlocking rows look beautiful */}
<style>
  .gallery-section-heading {
    margin: 36px 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    font-size: 1.25rem;
  }
  .gallery-item--video > a {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    background: var(--surface-raised);
  }
  .gallery-item--video > a > :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gallery-item--video img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.gallery.gallery-justified[data-enhanced] .gallery-item--video img),
  :global(.gallery.gallery-justified:not([data-enhanced]) .gallery-item--video img) {
    height: 100%;
    object-fit: cover;
  }
  .gallery-item--video[data-thumbnail-failed] img {
    visibility: hidden;
  }
  .gallery-video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    padding-left: 3px;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 50%;
    background: rgb(18 19 17 / 68%);
    color: #fff;
    font-size: 17px;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .gallery.gallery-justified {
    --gallery-gap: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gallery-gap);
    container: photography-gallery / inline-size;
  }
  .gallery.gallery-justified:not([data-enhanced]) .gallery-item {
    --fallback-row-height: 190px;
    flex: 0 1 calc(var(--ratio) * var(--fallback-row-height));
    min-width: 0;
    max-width: none;
    margin: 0;
  }
  .gallery.gallery-justified:not([data-enhanced]) .gallery-item a {
    display: block;
    height: auto;
    overflow: visible;
  }
  .gallery.gallery-justified:not([data-enhanced]) :global(picture),
  .gallery.gallery-justified:not([data-enhanced]) :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .gallery.gallery-justified[data-enhanced] {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: stretch;
  }
  .gallery.gallery-justified[data-enhanced] > :global(.gallery-row) {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    gap: var(--gallery-gap);
  }
  .gallery.gallery-justified[data-enhanced] > :global(.gallery-row) > .gallery-item {
    min-width: 0;
    max-width: none;
    margin: 0;
  }
  .gallery.gallery-justified[data-enhanced]
    > :global(.gallery-row[data-justified='true'])
    > .gallery-item {
    flex: var(--ratio) 1 0px;
  }
  .gallery.gallery-justified[data-enhanced]
    > :global(.gallery-row[data-justified='false'])
    > .gallery-item {
    flex: 0 0 var(--photo-width);
  }
  .gallery.gallery-justified[data-enhanced] > :global(.gallery-row) > .gallery-item > a {
    display: block;
    height: var(--row-height);
  }
  .gallery.gallery-justified[data-enhanced] :global(picture),
  .gallery.gallery-justified[data-enhanced] :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @container photography-gallery (min-width: 540px) {
    .gallery.gallery-justified:not([data-enhanced]) .gallery-item {
      --fallback-row-height: 250px;
    }
  }
  @container photography-gallery (min-width: 900px) {
    .gallery.gallery-justified:not([data-enhanced]) .gallery-item {
      --fallback-row-height: 290px;
    }
  }
</style>

<script>
  import { setupJustifiedGallery } from '../scripts/project-gallery';

  document.querySelectorAll<HTMLElement>('[data-justified-gallery]').forEach(setupJustifiedGallery);
  document.querySelectorAll<HTMLImageElement>('.gallery-item--video img').forEach((image) => {
    image.addEventListener(
      'error',
      () => image.closest('.gallery-item--video')?.setAttribute('data-thumbnail-failed', ''),
      { once: true },
    );
  });
</script>
