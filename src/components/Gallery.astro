---
// src/components/Gallery.astro
// A simple responsive image gallery for photography projects
import ResponsiveImage from './ResponsiveImage.astro';

const { images = [], columns = 3 } = Astro.props;

// Generate CSS grid columns based on the columns prop
const gridCols = `repeat(${columns}, minmax(0, 1fr))`;
---
<div class="gallery">
  <div class={`grid grid-cols-1 md:grid-cols-${columns} gap-4`}>
    {(images || []).map((image, index) => (
      <figure key={index} class="break-inside-avoid">
        <ResponsiveImage
          src={image.src}
          alt={image.alt || ''}
          width={image.width}
          height={image.height}
          priority={index < 3}
        />
        {image.caption && <figcaption class="text-sm text-muted text-center mt-2">{image.caption}</figcaption>}
      </figure>
    ))}
  </div>
</div>

<style>
  /* Gallery styles */
  .gallery {
    width: 100%;
  }

  .gallery img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.5rem;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .gallery .grid {
      grid-template-columns: 1fr;
    }
  }
</style>