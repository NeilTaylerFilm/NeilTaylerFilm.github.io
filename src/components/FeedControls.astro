---
// ==========================================
// 🎛️ FEED FILTER & SORT CONTROLS
// ==========================================
// This is the toolbar right above your list of articles or photo projects!
// It gives visitors two handy dropdown menus:
// 1. "Category" (e.g., show only 'Film' or 'Street')
// 2. "Sort" (newest first vs oldest first)
// It also shows a live count badge (like "08 articles").

// 📋 What this toolbar needs to know:
// Like setting up an exhibition catalog desk with the category labels and total piece count.
interface Props {
  // List of all categories available to filter by
  categories: string[];
  // Total number of items
  count: number;
  // Word to show after number (e.g. 'articles' or 'projects')
  noun?: string;
}
const { categories, count, noun = 'articles' } = Astro.props;
// --- BORROWED TOOLS (Imports) ---
// categoryKey: Converts nice category names like "Post-Production" into clean URL keys like "post-production".
import { categoryKey } from '../lib/feed';
---

{/* 🛠️ Toolbar wrapper containing dropdowns and item counter */}
<div class="feed-toolbar">
  {/* The form starts hidden until JavaScript initializes so visitors don't see non-functioning selects */}
  <form class="feed-controls" data-feed-controls hidden>
    {/* 🏷️ Dropdown 1: Category Filter */}
    <label>
      <span>Category</span>
      <div class="select-wrap">
        {/* Generates an option for each unique category found in this section */}
        <select name="category" aria-label="Filter by category">
          <option value="">All categories</option>
          {categories.map((category) => (
            <option value={categoryKey(category)}>{category}</option>
          ))}
        </select>
      </div>
    </label>

    {/* ⏳ Dropdown 2: Sort Order */}
    <label>
      <span>Sort</span>
      <div class="select-wrap">
        {/* Sort choices: Newest first (descending date) or Oldest first (ascending date) */}
        <select name="sort" aria-label="Sort by date">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </div>
    </label>
  </form>

  {/* 🔢 Live count text (e.g. "08 articles") */}
  {/* role="status" and aria-live="polite" announce count changes to screen readers */}
  <p class="feed-count mono" data-feed-count data-noun={noun} role="status" aria-live="polite">
    {String(count).padStart(2, '0')} {noun}
  </p>
</div>

{/* ℹ️ Backup message for visitors with JavaScript turned off */}
<noscript>
  <p class="small muted">
    All {noun} are shown, newest first. Enable JavaScript to filter and sort.
  </p>
</noscript>

<script>
  // 🔌 INTERACTIVE FILTER LOGIC:
  // Runs entirely in the visitor's browser for instant, smooth filtering!
  import { comparators, matchesCategory } from '../lib/feed';
  const form = document.querySelector<HTMLFormElement>('[data-feed-controls]');
  const feed = document.querySelector<HTMLElement>('[data-feed]');

  if (form && feed) {
    // Reveal the toolbar now that JavaScript is ready
    form.hidden = false;
    const category = form.elements.namedItem('category') as HTMLSelectElement;
    const sort = form.elements.namedItem('sort') as HTMLSelectElement;
    const items = Array.from(feed.querySelectorAll<HTMLElement>('[data-feed-item]'));
    const count = document.querySelector<HTMLElement>('[data-feed-count]');

    // 🪄 Function that sorts and hides/shows items based on what user picked
    // Calculates which items match the filter, sorts them by date, and updates the URL bar
    function apply(fromURL = false) {
      const url = new URL(location.href);
      // If loading from URL (like someone opened a shared link), pre-select dropdowns
      if (fromURL) {
        const value = url.searchParams.get('category') || '';
        category.value = Array.from(category.options).some((o) => o.value === value) ? value : '';
        sort.value = url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest';
      }

      // Pick our sorting rule (newest vs oldest)
      const comparator = comparators[sort.value as keyof typeof comparators] || comparators.newest;
      let visible = 0;

      // Sort the cards and show only those matching the selected category
      items
        .sort((a, b) =>
          comparator(
            { date: Number(a.dataset.date), id: a.dataset.id! },
            { date: Number(b.dataset.date), id: b.dataset.id! },
          ),
        )
        .forEach((item) => {
          const itemCategories: string[] = item.dataset.categories
            ? JSON.parse(item.dataset.categories)
            : [item.dataset.category || ''];
          item.hidden = !matchesCategory(itemCategories, category.value);
          if (!item.hidden) visible++;
          // Reorder on screen
          feed!.append(item);
        });

      // Update the counter badge text (e.g. "04 articles")
      if (count) count.textContent = `${String(visible).padStart(2, '0')} ${count.dataset.noun}`;

      // Update the browser URL bar so visitor can bookmark or share this exact view
      if (!fromURL) {
        category.value
          ? url.searchParams.set('category', category.value)
          : url.searchParams.delete('category');
        sort.value === 'oldest'
          ? url.searchParams.set('sort', 'oldest')
          : url.searchParams.delete('sort');
        if (url.href !== location.href) history.pushState({}, '', url);
      }
    }

    // Stop page from submitting like an old-fashioned form
    form.addEventListener('submit', (event) => event.preventDefault());
    // Apply changes whenever a dropdown changes
    form.addEventListener('change', () => apply());
    // Handle browser back/forward buttons
    window.addEventListener('popstate', () => apply(true));
    window.addEventListener('pageshow', () => apply(true));

    // 💾 Remember current filters in session memory so hitting "Back" preserves choices
    // Saves the current filter search string in sessionStorage so hitting the Back button restores it
    const remember = () => {
      try {
        sessionStorage.setItem(`archive:${location.pathname}`, location.pathname + location.search);
      } catch {}
    };
    form.addEventListener('change', remember);
    window.addEventListener('pagehide', remember);
    apply(true);
    remember();
  }
</script>

