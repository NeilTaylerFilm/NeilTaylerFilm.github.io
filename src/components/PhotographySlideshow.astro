---
// ==========================================
// 📽️ FEATURED PHOTOGRAPHY SLIDESHOW CAROUSEL
// ==========================================
// This is the gorgeous interactive slide projector on your Photography page!
// It features:
// - A big cinema screen showing your featured photos.
// - An "Expand" button for dark theater fullscreen viewing.
// - Previous/Next arrow buttons and a bottom thumbnail filmstrip.
// - Smooth swipe gestures on phones.

// --- BORROWED TOOLS (Imports) ---
// featured & featuredIsDemo: The curated list of master showcase photographs and sample flag from src/data/featured.ts.
import { featured as originalFeatured, featuredIsDemo } from '../data/featured';
// imageInfo: Helper to find image dimensions, aspect ratios, and WebP srcsets.
import { imageInfo } from '../lib/images';
// photography-viewer.css: Style rules for the projector layout, animations, and dark theater mode.
import '../styles/photography-viewer.css';

// 📚 Merge your featured photos list with image size data from the rolodex
// Combines each curated image with its calculated WebP srcset and pixel dimensions.
const featured = originalFeatured.map((photo) => ({ ...photo, ...imageInfo(photo.src) }));
// The very first photo to display when the page opens
const first = featured[0];
---

{/* Only render if there is at least one photo in the featured list */}
{/* Safety check: If no featured photographs exist in src/data/featured.ts, render nothing */}
{first && (
  <section
    class="slideshow photo-showcase"
    aria-label="Selected photographs"
    aria-roledescription="carousel"
    data-slideshow
    data-slides={JSON.stringify(featured)}
  >
    <div class="photo-panel" data-photo-panel>
      {/* 🛠️ Top Bar: Title status indicator, Expand button, and Close button */}
      <div class="photo-toolbar">
        <span class="mono">
          <span class="status-dot"></span> Selected photographs
        </span>
        {/* ⤢ Expand to Fullscreen Theater Button */}
        <button class="control" type="button" data-photo-expand aria-haspopup="dialog" hidden>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6" />
          </svg>
          Expand
        </button>
        {/* ✕ Close Fullscreen Button */}
        <button
          class="control photo-close"
          type="button"
          data-photo-close
          aria-label="Close expanded photographs"
        >
          <span aria-hidden="true">×</span> Close
        </button>
      </div>

      {/* 🖼️ Viewport: The frame where the active photograph shines */}
      <div class="photo-viewport" data-photo-viewport>
        {/* ⚡ Fast blurry preview so visitor never sees blank space while high-res loads */}
        {first.thumbnail && (
          <img
            class="photo-preview"
            src={first.thumbnail}
            width="192"
            height={Math.round((first.height * 192) / first.width)}
            alt=""
            aria-hidden="true"
          />
        )}
        {/* 📸 The main high-definition photograph */}
        <img
          data-slide-image
          src={first.src}
          srcset={first.srcset}
          sizes="(max-width: 1440px) 90vw, 1248px"
          width={first.width}
          height={first.height}
          alt={first.alt}
          fetchpriority="high"
          decoding="async"
        />
      </div>

      {/* 📝 Details Bar: Caption, Project link, and Next/Prev controls */}
      <div class="photo-details">
        <div class="photo-caption">
          <p data-slide-caption>{first.caption}</p>
          <a
            class="mono"
            data-photo-project
            href={first.project ? `/photography/${first.project}/` : undefined}
            hidden={!first.project}
          >
            View project →
          </a>
          {featuredIsDemo && <span class="mono muted">Sample photographs</span>}
        </div>
        <div class="slide-navigation">
          {/* 🔢 Slide counter (e.g. 01 / 04) */}
          <span
            class="mono small"
            data-slide-count
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            01 / {String(featured.length).padStart(2, '0')}
          </span>
          {/* ⬅️ Previous arrow */}
          <button
            class="control square"
            type="button"
            data-slide-prev
            aria-label="Previous photograph"
            hidden
          >
            ←
          </button>
          {/* ➡️ Next arrow */}
          <button
            class="control square"
            type="button"
            data-slide-next
            aria-label="Next photograph"
            hidden
          >
            →
          </button>
        </div>
      </div>

      {/* 🎞️ Bottom Filmstrip: Clickable row of miniature picture cards */}
      <div
        class="photo-filmstrip"
        data-photo-filmstrip
        role="group"
        aria-label="Choose a photograph"
        hidden
      >
        {featured.map((photo, index) => (
          <button
            class="photo-thumbnail"
            type="button"
            data-photo-index={index}
            aria-label={`Photograph ${index + 1} of ${featured.length}: ${photo.alt || 'Untitled photograph'}`}
            aria-current={index === 0 ? 'true' : undefined}
            tabindex={index === 0 ? 0 : -1}
          >
            <img
              src={photo.thumbnail || photo.srcset?.split(', ')[0].split(' ')[0] || photo.src}
              width={photo.width}
              height={photo.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
      {/* 🗣️ Invisible message box for blind screen reader users */}
      <p class="visually-hidden" data-photo-status role="status" aria-live="polite"></p>
    </div>

    {/* 🎭 Dark theater modal for fullscreen mode */}
    <dialog class="photo-dialog" data-photo-dialog aria-label="Expanded photographs"></dialog>
  </section>
)}

<script>
  // 🚀 Start up the viewer brain engine we built in photography-viewer.ts!
  // Borrow the setup helper function from our browser script library.
  import { setupPhotographyViewer } from '../scripts/photography-viewer';
  // Find every slideshow carousel on this web page and wake it up so buttons and gestures work!
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach(setupPhotographyViewer);
</script>

