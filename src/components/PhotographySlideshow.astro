---
import { featured as originalFeatured, featuredIsDemo } from '../data/featured';
import { imageInfo } from '../lib/images';
import '../styles/photography-viewer.css';
const featured = originalFeatured.map((photo) => ({ ...photo, ...imageInfo(photo.src) }));
const first = featured[0];
---

{first && (
  <section
    class="slideshow photo-showcase"
    aria-label="Selected photographs"
    aria-roledescription="carousel"
    data-slideshow
    data-slides={JSON.stringify(featured)}
  >
    <div class="photo-panel" data-photo-panel>
      <div class="photo-toolbar">
        <span class="mono">
          <span class="status-dot"></span> Selected photographs
        </span>
        <button class="control" type="button" data-photo-expand aria-haspopup="dialog" hidden>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6" />
          </svg>
          Expand
        </button>
        <button
          class="control photo-close"
          type="button"
          data-photo-close
          aria-label="Close expanded photographs"
        >
          <span aria-hidden="true">×</span> Close
        </button>
      </div>
      <div class="photo-viewport" data-photo-viewport>
        <img
          data-slide-image
          src={first.src}
          srcset={first.srcset}
          sizes="(max-width: 1440px) 90vw, 1248px"
          width={first.width}
          height={first.height}
          alt={first.alt}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="photo-details">
        <div class="photo-caption">
          <p data-slide-caption>{first.caption}</p>
          <a
            class="mono"
            data-photo-project
            href={first.project ? `/photography/${first.project}/` : undefined}
            hidden={!first.project}
          >
            View project →
          </a>
          {featuredIsDemo && <span class="mono muted">Sample photographs</span>}
        </div>
        <div class="slide-navigation">
          <span
            class="mono small"
            data-slide-count
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            01 / {String(featured.length).padStart(2, '0')}
          </span>
          <button
            class="control square"
            type="button"
            data-slide-prev
            aria-label="Previous photograph"
            hidden
          >
            ←
          </button>
          <button
            class="control square"
            type="button"
            data-slide-next
            aria-label="Next photograph"
            hidden
          >
            →
          </button>
        </div>
      </div>
      <div
        class="photo-filmstrip"
        data-photo-filmstrip
        role="group"
        aria-label="Choose a photograph"
        hidden
      >
        {featured.map((photo, index) => (
          <button
            class="photo-thumbnail"
            type="button"
            data-photo-index={index}
            aria-label={`Photograph ${index + 1} of ${featured.length}: ${photo.alt || 'Untitled photograph'}`}
            aria-current={index === 0 ? 'true' : undefined}
            tabindex={index === 0 ? 0 : -1}
          >
            <img
              src={photo.srcset?.split(', ')[0].split(' ')[0] || photo.src}
              width={photo.width}
              height={photo.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
      <p class="visually-hidden" data-photo-status role="status" aria-live="polite"></p>
    </div>
    <dialog class="photo-dialog" data-photo-dialog aria-label="Expanded photographs"></dialog>
  </section>
)}
<script>
  import { setupPhotographyViewer } from '../scripts/photography-viewer';
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach(setupPhotographyViewer);
</script>
