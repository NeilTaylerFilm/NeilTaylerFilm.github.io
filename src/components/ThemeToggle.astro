{/* ==========================================
     💡 LIGHT SWITCH (Dark / Light Mode Toggle)
     ==========================================
     This component is the light switch on your wall!
     It lets visitors toggle between a cozy dark screen and a bright light screen.
     It also remembers their choice the next time they visit! */}

{/* 🔘 The clickable button with the half-moon symbol */}
{/* The button starts out hidden so visitors with disabled JavaScript don't see a broken control. */}
<button
  class="theme-toggle control"
  type="button"
  aria-label="Light theme"
  aria-pressed="false"
  data-theme-toggle
  hidden
>
  {/* The half-moon glyph visually indicating day/night theme modes */}
  <span class="theme-symbol" aria-hidden="true">
    ◐
  </span>
  <span data-theme-label>Dark</span>
</button>

<script>
  // 🔌 Grab the button from the webpage
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  // ☀️ Check whether visitor's device is set to Light mode by default
  const system = matchMedia('(prefers-color-scheme: light)');
  // Stores what the user explicitly clicked
  let explicit: string | null = null;

  // 🔄 HELPER: Updates the button's label text and accessibility status
  // Keeps the screen-reader state (aria-pressed) aligned with the visual appearance.
  function sync() {
    const light = document.documentElement.dataset.theme === 'light';
    button?.setAttribute('aria-pressed', String(light));
    const label = button?.querySelector('[data-theme-label]');
    if (label) label.textContent = light ? 'Light' : 'Dark';
  }

  // 🧠 HELPER: Reads saved preference from browser memory (localStorage)
  // Like checking a sticky note on the fridge to remember what the user picked last time.
  function restore() {
    try {
      explicit = localStorage.getItem('neil-theme');
    } catch {}
    // If visitor chose before, use that; otherwise use their operating system setting!
    document.documentElement.dataset.theme =
      explicit === 'light' || explicit === 'dark' ? explicit : system.matches ? 'light' : 'dark';
    sync();
  }

  // 🚀 If JavaScript works, unhide the button and hook up the click listener
  if (button) {
    // Only show button if JavaScript is enabled
    button.hidden = false;
    // Set the theme right away
    restore();

    // 🖱️ When clicked: flip light to dark or dark to light!
    // Swaps the dataset.theme attribute on the root <html> element so CSS variables flip colors.
    button.addEventListener('click', () => {
      explicit = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = explicit;
      try {
        // Save choice in browser memory so it stays when they reload!
        localStorage.setItem('neil-theme', explicit);
      } catch {}
      sync();
    });

    // 👂 Listen for OS system theme changes, page restores, and multi-tab sync
    // When the user changes their operating system theme or flips the toggle in another open tab:
    system.addEventListener('change', restore);
    window.addEventListener('pageshow', restore);
    window.addEventListener('storage', (event) => {
      if (event.key === 'neil-theme') restore();
    });
  }
</script>

