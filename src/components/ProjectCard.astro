---
// ==========================================
// 📸 PHOTOGRAPHY PROJECT CARD (Album Teaser)
// ==========================================
// This is a photo album box shown in your photography portfolio gallery!
// It displays the big cover photo, the album title, year/location,
// and how many photos are inside (e.g., "14 photographs").

// Photography project card with cover image and metadata
// --- BORROWED TOOLS (Imports) ---
// CollectionEntry: A strict TypeScript rule defining a valid photography album from the content drawers.
import type { CollectionEntry } from 'astro:content';

// ProjectMetadata: The neat little label component showing the category, year, and location.
import ProjectMetadata from './ProjectMetadata.astro';
// ResponsiveImage: Our smart photo frame that serves lightweight WebP images at exact visitor screen sizes.
import ResponsiveImage from './ResponsiveImage.astro';
// projectTimestamp and filterValues: Helpers for sorting and category filtering.
import { projectTimestamp } from '../lib/content';
import { filterValues } from '../lib/feed';
import { imageInfo } from '../lib/images';
import { youtubeThumbnailUrl } from '../lib/youtube';

// 📋 What this card needs to show an album:
// Like a recipe checklist, declaring this component requires one photography project album.
interface Props {
  // One photography collection project
  project: CollectionEntry<'photography'>;
}

// Open the envelope passed to this card by the gallery page
const { project } = Astro.props;
// Unpack the album's notebook sheet (title, cover, images list, year, category)
const { data } = project;

// 🖼️ Pick the cover photo: use coverImage, or cover, or fallback to photo #1 in the album
// Like picking the prettiest photo to put on the cover of a physical photo book!
const firstMedia = data.images[0];
const firstPreview =
  firstMedia?.type === 'video'
    ? firstMedia.poster || youtubeThumbnailUrl(firstMedia.videoId)
    : firstMedia?.src;
const cover = data.coverImage || data.cover || firstPreview;
const coverMedia = data.images.find((media) =>
  media.type === 'video'
    ? (media.poster || youtubeThumbnailUrl(media.videoId)) === cover
    : media.src === cover,
);
const coverInfo = cover ? imageInfo(cover) : undefined;
const photoCount = data.images.filter((media) => media.type !== 'video').length;
const videoCount = data.images.length - photoCount;
const photoLabel = photoCount === 1 ? 'photograph' : 'photographs';
const videoLabel = videoCount === 1 ? 'video' : 'videos';
---

{/* 📦 Card wrapper with filtering tags for category and date */}
<article
  class="project-card"
  data-feed-item
  data-filter-values={JSON.stringify(filterValues(data, 'category'))}
  data-date={projectTimestamp(data)}
  data-id={project.id}
>
  {/* 🖼️ Big cover photo linking into the album */}
  {cover && (
    <a class="project-cover" href={`/photography/${project.id}/`} tabindex="-1" aria-hidden="true">
      <ResponsiveImage
        src={cover}
        width={coverInfo?.width || coverMedia?.width || 480}
        height={coverInfo?.height || coverMedia?.height || 360}
        alt=""
        sizes="(max-width: 540px) calc(100vw - 40px), (max-width: 1050px) 45vw, 420px"
      />
      {/* ➡️ Sleek hover arrow indicator */}
      <span class="project-open" aria-hidden="true">
        <span>→</span>
      </span>
    </a>
  )}

  {/* 🏷️ Metadata tags (category, year/date) */}
  <ProjectMetadata {...data} />

  {/* 🏷️ Album title headline */}
  <h2>
    <a href={`/photography/${project.id}/`}>{data.title}</a>
  </h2>

  {/* 📝 Optional album subtitle */}
  {(data.description || data.subtitle) && <p class="muted">{data.description || data.subtitle}</p>}

  {/* 🔢 Count of photographs and videos inside this album */}
  {data.images.length > 0 && (
    <p class="mono small">
      {photoCount > 0 && `${String(photoCount).padStart(2, '0')} ${photoLabel}`}
      {photoCount > 0 && videoCount > 0 && ' · '}
      {videoCount > 0 && `${String(videoCount).padStart(2, '0')} ${videoLabel}`}
    </p>
  )}
</article>
