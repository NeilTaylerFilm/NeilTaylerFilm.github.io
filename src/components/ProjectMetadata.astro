---
// ==========================================
// 🏷️ PROJECT INFO STRIP (Category, City & Date)
// ==========================================
// This component prints optional project details above a project title.
// It can show a primary category, one tag, location, and date in one line.

// Project metadata line with category, location and date
// --- BORROWED TOOLS (Imports) ---
// isoDate: Formats raw calendar dates into universal computer-friendly strings (YYYY-MM-DD).
import { isoDate, displayLabel } from '../lib/feed';

// 📋 What this component can display:
// A menu of optional details: projects can have some, all, or none of these.
interface Props {
  // Primary project category (e.g. 'Travel', 'Explainer')
  category?: string;
  // Secondary labels (only the first distinct tag is displayed)
  tags?: string[];
  // Where it was shot (e.g. 'Thailand', 'London')
  location?: string;
  // The exact calendar date
  date?: Date;
  // Or just the year (e.g. 2024)
  year?: string | number;
}

// Unpack the provided props
const { category, tags, location, date, year } = Astro.props;
// Category shows as the outlined pill; the first tag shows as plain text.
const label = displayLabel({ category, tags });
// Build a simple date text stamp
// If an exact calendar date is available, convert it to YYYY-MM-DD; otherwise use the plain year string.
const stamp = date ? isoDate(date) : year?.toString();
---

{/* Only show this line if at least one piece of info exists */}
{(label.category || label.tag || location || stamp) && (
  <div class="metadata">
    {/* 🏷️ Category pill (outlined) and first tag (plain text) */}
    {label.category && <span class="category-pill">{label.category}</span>}
    {label.tag && <span class="tag-label">{label.tag}</span>}

    {/* 📍 Location name */}
    {location && <span>{location}</span>}
    {/* Middle dot separator if date follows */}
    {location && stamp && <span aria-hidden="true">·</span>}

    {/* 📅 Exact dates use YYYY-MM-DD; year-only projects keep the year */}
    {stamp && <time datetime={stamp}>{stamp}</time>}
  </div>
)}
