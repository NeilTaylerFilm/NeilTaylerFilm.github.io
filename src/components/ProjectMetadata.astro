---
import { isoDate } from '../lib/feed';
interface Props {
  category?: string;
  location?: string;
  date?: Date;
  year?: string | number;
}
const { category, location, date, year } = Astro.props;
const stamp = date ? isoDate(date) : year?.toString();
---

{(category || location || stamp) && (
  <div class="metadata">
    {category && <span class="category">{category}</span>}
    {category && (location || stamp) && <span aria-hidden="true">/</span>}
    {location && <span>{location}</span>}
    {location && stamp && <span aria-hidden="true">·</span>}
    {stamp && (
      <time datetime={stamp}>
        {date
          ? new Intl.DateTimeFormat('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
              timeZone: 'UTC',
            }).format(date)
          : stamp}
      </time>
    )}
  </div>
)}
