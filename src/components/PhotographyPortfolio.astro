---
import ResponsiveImage from './ResponsiveImage.astro';
import PhotoViewer from './PhotoViewer.astro';
import {
  portfolioPhotos,
  validatePortfolio,
  type PortfolioPhoto,
} from '../data/photography-portfolio';
import { imageInfo } from '../lib/images';
import { projects } from '../lib/content';

interface Props {
  photos?: PortfolioPhoto[];
}
const { photos = portfolioPhotos } = Astro.props;
const TEST_GRID = false;
const galleryProjects = await projects();
let displayPhotos = [...photos];

if (TEST_GRID && !Astro.props.photos) {
  const featuredSources = new Set(displayPhotos.map((photo) => photo.src));
  const galleryPhotos = galleryProjects.flatMap((project) =>
    project.data.images.flatMap((photo, index) => {
      const info = imageInfo(photo.src);
      if (!info || featuredSources.has(photo.src)) return [];
      return [
        {
          src: photo.src,
          width: info.width,
          height: info.height,
          alt: photo.alt || `${project.data.title}, photograph ${index + 1}`,
          projectSlug: project.id,
        },
      ];
    }),
  );
  const select = (orientation: 'portrait' | 'landscape', quotas: Record<string, number>) =>
    Object.entries(quotas).flatMap(([projectSlug, count]) =>
      galleryPhotos
        .filter((photo) => {
          const ratio = photo.width / photo.height;
          return (
            photo.projectSlug === projectSlug &&
            (orientation === 'portrait' ? ratio < 1 : ratio > 1)
          );
        })
        .sort((a, b) => {
          const ratioA = a.width / a.height;
          const ratioB = b.width / b.height;
          return orientation === 'portrait' ? ratioA - ratioB : ratioB - ratioA;
        })
        .slice(0, count),
    );
  const portraits = select('portrait', {
    '20260809-late-night-drive-bts': 6,
    '20260627-matt-louise-engagement': 8,
    '20251130-flackwell-heath-vs-barton': 2,
  });
  const landscapes = select('landscape', {
    '20260809-late-night-drive-bts': 11,
    '20260627-matt-louise-engagement': 5,
    '20251130-flackwell-heath-vs-barton': 4,
  });
  const testPhotos = [
    ...Array.from({ length: portraits.length / 2 }, (_, index) => [
      ...portraits.slice(index * 2, index * 2 + 2),
      ...landscapes.slice(index * 2, index * 2 + 2),
    ]).flat(),
    ...landscapes.slice(portraits.length),
  ];
  if (testPhotos.length !== 36)
    throw new Error(`Photography grid test expected 36 extra photos, got ${testPhotos.length}.`);
  displayPhotos = [...displayPhotos, ...testPhotos];
}

validatePortfolio(displayPhotos, new Set(galleryProjects.map((project) => project.id)), imageInfo);
const hasProjectLinks = displayPhotos.some((photo) => Boolean(photo.projectSlug));
---

<section class="portfolio" data-portfolio aria-label="Selected photographs">
  <script is:inline>
    document.currentScript.parentElement.setAttribute('data-enhanced', '');
  </script>
  <div class="portfolio-grid" data-portfolio-grid>
    {displayPhotos.map((photo, index) => {
      const info = imageInfo(photo.src)!;
      const projectUrl = photo.projectSlug ? `/photography/${photo.projectSlug}/` : undefined;
      const isLandscape = photo.width > photo.height;
      return (
        <a
          class:list={['portfolio-photo', { 'portfolio-photo--landscape': isLandscape }]}
          href={projectUrl ?? photo.src}
          data-project-url={projectUrl}
          style={`--ar: ${photo.width / photo.height}`}
          data-portfolio-photo
          data-full={info.full}
          data-srcset={info.srcset}
        >
          <ResponsiveImage
            {...photo}
            sizes={`${index < 8 ? '' : 'auto, '}(max-width: 640px) ${isLandscape ? '100vw' : '50vw'}, (max-width: 900px) 33vw, 400px`}
            loading={index === 0 ? 'eager' : 'lazy'}
            priority={index === 0}
          />
        </a>
      );
    })}
  </div>
  <div class="portfolio-more">
    <button class="control" type="button" data-portfolio-more hidden>
      Load More Photographs
    </button>
    <span class="mono small" data-portfolio-status role="status" aria-live="polite"></span>
  </div>
  <PhotoViewer label="Selected photographs" projectLinks={hasProjectLinks} />
</section>

<script>
  import { setupPortfolio } from '../scripts/photography-portfolio';
  document.querySelectorAll<HTMLElement>('[data-portfolio]').forEach(setupPortfolio);
</script>

<style>
  .portfolio {
    --photo-gap: 6px;
    --target-row-height: 320px;
  }
  @media (max-width: 899px) {
    .portfolio {
      --target-row-height: 260px;
    }
  }
  .portfolio-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--photo-gap);
  }
  .portfolio-photo {
    flex: 0 0 var(--row-width);
    min-width: 0;
    align-self: start;
    display: block;
    height: var(--row-height);
    aspect-ratio: var(--ar);
  }
  .portfolio-photo :global(picture),
  .portfolio-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .portfolio-photo:hover {
    opacity: 0.9;
  }
  .portfolio[data-enhanced] .portfolio-photo:nth-child(n + 25):not([data-revealed]),
  .portfolio-photo[hidden] {
    display: none;
  }
  .portfolio-more {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .portfolio-more [data-portfolio-status]:not(:empty) {
    margin-top: 12px;
  }
  .portfolio-more:has(button:not([hidden])) {
    margin-top: 20px;
  }
</style>
