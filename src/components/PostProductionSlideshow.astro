---
// ==========================================
// 🍿 VIDEO & FILM SCREENING ROOM CAROUSEL
// ==========================================
// This is the interactive movie theater on your Post-Production page!
// It features:
// - Movie posters with a big round "Play" button in the center.
// - Clicking Play seamlessly pops up a YouTube or Vimeo video player right inside the frame!
// - A filmstrip at the bottom with video preview thumbnails.
// - A "Learn more…" button that links directly to a behind-the-scenes blog post if published!

// --- BORROWED TOOLS (Imports) ---
// originalFeatured & featuredIsDemo: The showcase list of films/videos and demo watermark indicator.
import { featured as originalFeatured, featuredIsDemo } from '../data/post-production-featured';
// getCollection: Astro tool that opens content drawers to read our articles and projects.
import { getCollection } from 'astro:content';
// videoEmbedUrl & linkedBlogUrl: Smart converters turning video links into embed players and connecting blog posts.
import {
  videoEmbedUrl,
  linkedBlogUrl,
  roleLine,
  validateFeaturedProjectReferences,
} from '../lib/post-production';
import { projectLinkForSlide } from '../lib/project-links';
// imageInfo: Helper finding image dimensions and WebP responsive formats.
import { imageInfo } from '../lib/images';
import PlayIcon from './PlayIcon.astro';
// photography-viewer.css: Shared slideshow controls, transitions, and thumbnail styles.
import '../styles/photography-viewer.css';

// 📚 Find all blog posts that are live and published (not drafts)
const publishedPosts = new Set(
  (await getCollection('blog')).filter((post) => !post.data.draft).map((post) => post.id),
);
const publishedPostProductionArticles = new Set(
  (await getCollection('postProduction'))
    .filter((article) => !article.data.draft)
    .map((article) => article.id),
);
validateFeaturedProjectReferences(originalFeatured, publishedPostProductionArticles);

// 🎞️ Assemble the video works with images, video embed links, and blog links
// Keep the poster usable as a plain image even when it has no generated image variants.
const featured = originalFeatured.map((photo) => ({
  ...photo,
  ...imageInfo(photo.poster || photo.src),
  src: imageInfo(photo.poster || photo.src)?.src || photo.poster || photo.src,
  embedUrl: videoEmbedUrl(photo.video),
  blogUrl: linkedBlogUrl(photo.blogPost, publishedPosts),
}));
// The very first video to show on the screen
const first = featured[0];
const firstRoleLine = first ? roleLine(first.role, first.subtitle) : undefined;
const firstProjectLink = first
  ? projectLinkForSlide(first, '/post-production/')
  : { href: undefined, hidden: true, label: 'View project →' };
---

{/* Only render if there is at least one video project in the list */}
{first && (
  <section
    class="slideshow photo-showcase"
    aria-label="Selected post-production work"
    aria-roledescription="carousel"
    data-slideshow
    data-video-viewer
    data-slide-noun="project"
    data-project-base="/post-production/"
    data-slides={JSON.stringify(featured)}
  >
    <div class="photo-panel video-panel" data-photo-panel>
      <div class="video-frame">
        <div class="photo-viewport" data-photo-viewport data-playing="false">
          <img
            data-slide-image
            src={first.src}
            srcset={first.srcset}
            sizes="(max-width: 1440px) 90vw, 1248px"
            width={first.width}
            height={first.height}
            alt={first.alt}
            fetchpriority="high"
            decoding="async"
          />

          <div class="photo-toolbar">
            <a
              class="control square watch-link"
              data-watch-link
              href="#"
              aria-label="Watch on YouTube"
              title="Watch on YouTube"
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                <path d="M14 3h7v7m0-7-9 9" />
                <path d="M10 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" />
              </svg>
              <span class="visually-hidden">
                Watch on <span data-platform-name>YouTube</span>
              </span>
            </a>
          </div>

          <button
            class="control square video-back"
            data-video-back
            type="button"
            aria-label="Back to posters"
            title="Back to posters"
            hidden
          >
            <span aria-hidden="true">×</span>
          </button>

          <button
            class="video-play"
            data-video-play
            aria-label={`Watch ${first.caption || 'film'}`}
            type="button"
            hidden={!first.embedUrl}
          >
            <PlayIcon className="stage-play-icon" size={72} />
          </button>

          <p class="video-player-status" data-video-status role="status" aria-live="polite"></p>

          <div class="slide-navigation" role="group" aria-label="Work navigation">
            <button
              class="control square"
              type="button"
              data-slide-prev
              aria-label="Previous work"
              hidden
            >
              ←
            </button>
            <button
              class="control square"
              type="button"
              data-slide-next
              aria-label="Next work"
              hidden
            >
              →
            </button>
          </div>

          <span
            class="mono small photo-counter"
            data-slide-count
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            01 / {String(featured.length).padStart(2, '0')}
          </span>
        </div>

        <div class="photo-details">
          <div class="work-actions">
            {first.type?.trim() && (
              <span class="type-pill" data-slide-type>
                {first.type.trim()}
              </span>
            )}
            <p class="work-title" data-slide-caption>
              {first.caption}
            </p>
            {firstRoleLine && (
              <p class="work-subtitle" data-slide-subtitle>
                {firstRoleLine}
              </p>
            )}
            <div class="work-links" hidden={!first.project && !first.blogUrl && !featuredIsDemo}>
              <a
                class="mono project-link"
                data-photo-project
                href={firstProjectLink.href}
                hidden={firstProjectLink.hidden}
              >
                {firstProjectLink.label}
              </a>

              {featuredIsDemo && <span class="mono muted">Sample work</span>}

              <a
                class="mono work-learn-more"
                data-work-learn-more
                href={first.blogUrl}
                hidden={!first.blogUrl}
              >
                Learn more…
              </a>
            </div>
          </div>
        </div>
      </div>

      <div
        class="photo-filmstrip"
        data-photo-filmstrip
        role="group"
        aria-label="Choose a work"
        style={`--project-count: ${featured.length}`}
        hidden
      >
        {featured.map((work, index) => (
          <button
            class="photo-thumbnail"
            type="button"
            data-photo-index={index}
            aria-label={`Work ${index + 1} of ${featured.length}: ${work.caption || 'Untitled work'}`}
            title={work.caption || 'Untitled work'}
            aria-current={index === 0 ? 'true' : undefined}
            tabindex={index === 0 ? 0 : -1}
          >
            {work.video ? (
              <div class="video-thumbnail-wrapper">
                <img
                  src={work.src}
                  width={work.width}
                  height={work.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <PlayIcon className="video-play-icon" size={48} />
              </div>
            ) : (
              <img
                src={work.srcset?.split(', ')[0].split(' ')[0] || work.src}
                width={work.width}
                height={work.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
          </button>
        ))}
      </div>
      <p class="visually-hidden" data-photo-status role="status" aria-live="polite"></p>
    </div>
  </section>
)}

<script>
  // 🚀 Start up the base photo slideshow logic
  import { setupPhotographyViewer } from '../scripts/photography-viewer';
  import { roleLine } from '../lib/post-production';
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach(setupPhotographyViewer);

  // 🎬 EXTRA VIDEO CONTROLLER: Handles clicking the Play button and embedding video iframes
  document.querySelectorAll<HTMLElement>('[data-video-viewer]').forEach((root) => {
    // Unpack the film metadata list stored right inside the HTML element's data pocket
    const slides: Array<{
      embedUrl?: string;
      blogUrl?: string;
      caption?: string;
      type?: string;
      subtitle?: string;
      role?: string[];
      video?: string;
    }> = JSON.parse(root.dataset.slides || '[]');
    // Grab the screen box where posters and video players appear
    const viewport = root.querySelector<HTMLElement>('[data-photo-viewport]')!;
    const strip = root.querySelector<HTMLElement>('[data-photo-filmstrip]')!;
    let stripScrollFrame = 0;
    function updateStripEdges() {
      const maxScrollLeft = strip.scrollWidth - strip.clientWidth;
      const hasOverflow = maxScrollLeft > 1;
      strip.toggleAttribute('data-scrolled-start', hasOverflow && strip.scrollLeft > 1);
      strip.toggleAttribute(
        'data-scrolled-end',
        hasOverflow && strip.scrollLeft < maxScrollLeft - 1,
      );
      stripScrollFrame = 0;
    }
    function scheduleStripEdgeUpdate() {
      if (stripScrollFrame) return;
      stripScrollFrame = window.requestAnimationFrame(updateStripEdges);
    }
    strip.addEventListener('scroll', scheduleStripEdgeUpdate, { passive: true });
    window.addEventListener('resize', scheduleStripEdgeUpdate, { passive: true });
    updateStripEdges();
    // The big round play button hovering over the poster
    const play = root.querySelector<HTMLButtonElement>('[data-video-play]')!;
    const back = root.querySelector<HTMLButtonElement>('[data-video-back]')!;
    // Status text element to inform visitors if video is taking long to load
    const playerStatus = root.querySelector<HTMLElement>('[data-video-status]')!;
    // The "Learn more..." link button leading to behind-the-scenes stories
    const more = root.querySelector<HTMLAnchorElement>('[data-work-learn-more]')!;
    const workLinks = root.querySelector<HTMLElement>('.work-links')!;
    const sampleWork = root.querySelector<HTMLElement>('.work-links .muted');
    const projectLink = root.querySelector<HTMLAnchorElement>('[data-photo-project]')!;
    // External icon link to the work on YouTube or Vimeo
    const watchLink = root.querySelector<HTMLAnchorElement>('[data-watch-link]')!;
    // The label text saying "YouTube" or "Vimeo"
    const platformName = watchLink.querySelector<HTMLSpanElement>('[data-platform-name]')!;
    const title = root.querySelector<HTMLElement>('[data-slide-caption]')!;
    let typeLabel = root.querySelector<HTMLElement>('[data-slide-type]');
    let subtitle = root.querySelector<HTMLElement>('[data-slide-subtitle]');
    // A stopwatch timer ID so we can alert the visitor if video loading stalls
    let playerTimer = 0;

    function resetPlayback(index?: number) {
      viewport.querySelector('iframe.video-iframe')?.remove();
      window.clearTimeout(playerTimer);
      playerStatus.textContent = '';
      viewport.dataset.playing = 'false';
      back.hidden = true;
      if (index !== undefined) play.hidden = !slides[index]?.embedUrl;
    }

    // 🔄 When user flips to another slide, remove old video player and refresh links
    function update() {
      const index = Number(root.dataset.index || 0);
      resetPlayback(index);
      const work = slides[index];
      play.setAttribute('aria-label', `Watch ${work.caption || 'film'}`);
      const typeText = work.type?.trim();
      if (typeText) {
        if (!typeLabel) {
          typeLabel = document.createElement('span');
          typeLabel.className = 'type-pill';
          typeLabel.dataset.slideType = '';
          title.before(typeLabel);
        }
        typeLabel.textContent = typeText;
      } else {
        typeLabel?.remove();
        typeLabel = null;
      }
      const subtitleText = roleLine(work.role, work.subtitle);
      if (subtitleText) {
        if (!subtitle) {
          subtitle = document.createElement('p');
          subtitle.className = 'work-subtitle';
          subtitle.dataset.slideSubtitle = '';
          title.after(subtitle);
        }
        subtitle.textContent = subtitleText;
      } else {
        subtitle?.remove();
        subtitle = null;
      }
      if (work.blogUrl) {
        more.href = work.blogUrl;
        more.hidden = false;
      } else {
        more.removeAttribute('href');
        more.hidden = true;
      }
      workLinks.hidden = projectLink.hidden && more.hidden && !sampleWork;
      if (work.embedUrl && work.video) {
        const host = new URL(work.video).hostname.replace(/^www\./, '');
        const platform = host.includes('vimeo') ? 'Vimeo' : 'YouTube';
        const label = `Watch on ${platform}`;
        platformName.textContent = platform;
        watchLink.setAttribute('aria-label', label);
        watchLink.title = label;
        watchLink.href = work.video;
        watchLink.hidden = false;
      } else {
        watchLink.hidden = true;
      }
    }

    // Listen for slide change events fired by the photography-viewer engine
    root.addEventListener('photo-change', update);
    root.addEventListener('photo-select', (event) => {
      resetPlayback();
      const index = (event as CustomEvent<number>).detail;
      play.hidden = index !== Number(root.dataset.index || 0) || !slides[index]?.embedUrl;
    });
    root.addEventListener('photo-error', (event) => {
      const index = (event as CustomEvent<number>).detail;
      play.hidden = !slides[index]?.embedUrl;
    });
    back.addEventListener('click', () => {
      const index = Number(root.dataset.index || 0);
      resetPlayback(index);
      if (!play.hidden) play.focus({ preventScroll: true });
    });

    // When visitor clicks the big Play button:
    play?.addEventListener('click', (event) => {
      event.stopPropagation();
      const work = slides[Number(root.dataset.index || 0)];
      if (!work.embedUrl) return;

      // 📺 Build the YouTube or Vimeo iframe TV screen!
      const iframe = document.createElement('iframe');
      iframe.src = work.embedUrl;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.setAttribute('allowfullscreen', '');
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'video-iframe';
      iframe.title = work.caption || 'Film player';
      iframe.setAttribute('aria-busy', 'true');
      playerStatus.textContent = 'Loading player…';

      // If it takes more than 8 seconds, show a polite note
      playerTimer = window.setTimeout(() => {
        if (iframe.isConnected && viewport.querySelector('iframe') === iframe)
          playerStatus.textContent = 'Player is taking a while to load.';
      }, 8000);

      // When the video finishes loading:
      iframe.addEventListener(
        'load',
        () => {
          // A different slide may have replaced this player while it was loading.
          if (!iframe.isConnected || viewport.querySelector('iframe') !== iframe) return;
          window.clearTimeout(playerTimer);
          iframe.removeAttribute('aria-busy');
          playerStatus.textContent = '';
          viewport.dataset.playing = 'true';
          back.hidden = false;
        },
        { once: true },
      );

      // If video failed to load (e.g. offline):
      iframe.addEventListener(
        'error',
        () => {
          // Ignore errors from a player that is no longer on screen.
          if (!iframe.isConnected || viewport.querySelector('iframe') !== iframe) return;
          window.clearTimeout(playerTimer);
          iframe.removeAttribute('aria-busy');
          playerStatus.textContent =
            'Player could not load. Use the Watch on link to open it directly.';
        },
        { once: true },
      );

      viewport.append(iframe);
      viewport.dataset.playing = 'true';
      back.hidden = false;
      // Hide the play button since video is playing
      play.hidden = true;
      iframe.focus();
    });
    update();
  });
</script>

<style>
  .photo-showcase {
    border: 0;
    background: transparent;
  }
  .video-panel {
    background: transparent;
  }
  .video-panel .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    --stage-fg: #fff;
    --stage-muted: rgba(255, 255, 255, 0.7);
    --stage-bg: rgba(0, 0, 0, 0.45);
    --stage-bg-hover: rgba(0, 0, 0, 0.65);
    --stage-border: rgba(255, 255, 255, 0.25);
  }
  .video-panel .photo-viewport {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    cursor: default;
  }
  :global(.video-panel .photo-viewport > img) {
    object-fit: cover;
  }
  :global(.video-panel .photo-viewport iframe.video-iframe) {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .photo-toolbar {
    position: absolute;
    z-index: 6;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    justify-content: flex-end;
    gap: var(--space-1);
    padding: 0;
    border: 0;
    pointer-events: none;
  }
  .photo-toolbar .control {
    min-height: 44px;
    padding: 8px 12px;
    color: var(--stage-fg);
    pointer-events: auto;
  }
  .photo-toolbar .watch-link {
    width: 44px;
    height: 44px;
    padding: 0;
  }
  .photo-toolbar svg {
    flex-shrink: 0;
  }
  .photo-toolbar .control,
  .slide-navigation .control,
  .photo-counter,
  .video-back {
    color: var(--stage-fg);
    background: var(--stage-bg);
    border: 1px solid var(--stage-border);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .video-back {
    position: absolute;
    z-index: 7;
    top: var(--space-2);
    left: var(--space-2);
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    opacity: 0.45;
    pointer-events: auto;
    transition:
      opacity 150ms ease,
      visibility 150ms ease;
  }
  .video-back[hidden] {
    display: none;
  }
  .photo-toolbar,
  .photo-toolbar .watch-link,
  .slide-navigation,
  .photo-counter,
  .photo-details,
  .video-player-status {
    transition:
      opacity 150ms ease,
      visibility 150ms ease;
  }
  .video-back:hover,
  .video-back:focus-visible {
    opacity: 1;
  }
  .video-play {
    z-index: 4;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 72%);
    color: var(--stage-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s;
  }
  .photo-toolbar .control:hover,
  .photo-toolbar .control:focus-visible,
  .slide-navigation .control:hover,
  .slide-navigation .control:focus-visible,
  .video-back:hover,
  .video-back:focus-visible,
  .video-play:hover,
  .video-play:focus-visible {
    color: var(--stage-fg);
    background: var(--stage-bg-hover);
    border-color: var(--stage-border);
  }
  .video-panel .photo-viewport :is(a, button):focus-visible {
    outline: 2px solid var(--stage-fg);
    outline-offset: 2px;
  }
  .video-player-status:not(:empty) {
    position: absolute;
    z-index: 6;
    top: 50%;
    left: 50%;
    width: max-content;
    max-width: calc(100% - 32px);
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 7px 10px;
    background: var(--stage-bg);
    color: var(--stage-fg);
    font: 11px var(--mono);
    text-align: center;
    border: 1px solid var(--stage-border);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }
  .slide-navigation {
    position: absolute;
    z-index: 5;
    inset: 50% 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: var(--space-2);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .slide-navigation .control {
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    color: var(--stage-fg);
    pointer-events: auto;
  }
  @media (hover: hover) {
    .photo-toolbar .watch-link,
    .slide-navigation {
      opacity: 0;
      transition:
        opacity 150ms ease,
        visibility 150ms ease;
    }
    .photo-toolbar .watch-link,
    .slide-navigation .control {
      pointer-events: none;
    }
    .photo-viewport:hover .photo-toolbar .watch-link,
    .photo-viewport:focus-within .photo-toolbar .watch-link,
    .photo-viewport:hover .slide-navigation,
    .photo-viewport:focus-within .slide-navigation {
      opacity: 1;
    }
    .photo-viewport:hover .photo-toolbar .watch-link,
    .photo-viewport:focus-within .photo-toolbar .watch-link,
    .photo-viewport:hover .slide-navigation .control,
    .photo-viewport:focus-within .slide-navigation .control {
      pointer-events: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-toolbar,
    .photo-toolbar .watch-link,
    .slide-navigation,
    .photo-counter,
    .photo-details,
    .video-player-status,
    .video-back {
      transition: none;
    }
  }
  .photo-counter {
    position: absolute;
    z-index: 5;
    top: var(--space-2);
    left: var(--space-2);
    margin: 0;
    padding: 6px 8px;
    border-radius: var(--radius);
    color: var(--stage-fg);
    line-height: 1.2;
    pointer-events: none;
  }
  .photo-details {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-2);
    min-height: 0;
    padding: var(--space-4) var(--space-3) var(--space-2);
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgb(0 0 0 / 58%) 45%,
      rgb(0 0 0 / 88%) 100%
    );
    color: var(--stage-fg);
    pointer-events: none;
  }
  .photo-viewport[data-playing='true'] .photo-toolbar,
  .photo-viewport[data-playing='true'] .photo-toolbar .watch-link,
  .photo-viewport[data-playing='true'] .slide-navigation,
  .photo-viewport[data-playing='true'] .slide-navigation .control,
  .photo-viewport[data-playing='true'] .photo-counter,
  .photo-viewport[data-playing='true'] .video-player-status {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .work-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    max-width: min(70ch, calc(100% - 56px));
    min-width: 0;
  }
  :global(.work-actions [data-slide-type]) {
    align-self: flex-start;
  }
  :global(.work-actions .type-pill) {
    border-color: var(--stage-border);
    color: var(--stage-muted);
    font: 400 11px / 1.4 var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .work-title {
    max-width: 70ch;
    margin: 0;
    color: var(--stage-fg);
    font: 600 clamp(14px, 1.8vw, 19px) / 1.25 var(--sans);
    overflow-wrap: anywhere;
    text-shadow: 0 1px 10px rgb(0 0 0 / 85%);
  }
  :global(.video-panel .work-subtitle) {
    max-width: 100%;
    margin: 0;
    overflow: hidden;
    color: var(--stage-muted);
    font: 400 clamp(11px, 1.3vw, 13px) / 1.35 var(--sans);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .work-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    pointer-events: auto;
  }
  .project-link,
  .work-learn-more {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--stage-fg);
