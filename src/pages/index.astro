---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import FeedControls from '../components/FeedControls.astro';
import { posts } from '../lib/content';
const allPosts = await posts();
const categories = [...new Set(allPosts.map((post) => post.data.category))].sort();
---

<BaseLayout title="Writing & observations">
  <section class="content-start" aria-label="Blog articles">
    <div class="section-heading">
      <h1 class="eyebrow">The latest entries</h1>
      <span class="line-decoration" aria-hidden="true"></span>
    </div>
    <FeedControls categories={categories} count={allPosts.length} />
    <div class="blog-feed" data-feed>
      {allPosts.map((post, index) => (
        <BlogCard post={post} index={index} />
      ))}
    </div>
    {!allPosts.length && <p class="empty-state">The first entry is on its way. Check back soon.</p>}
    <div class="end-note mono">
      <span aria-hidden="true">■</span> You’re all caught up. More when there’s more.
    </div>
  </section>
  <aside class="photography-callout">
    <div>
      <span class="eyebrow">Away from the keyboard</span>
      <h2>
        Some things are
        <br />
        better <span class="serif-word">seen.</span>
      </h2>
    </div>
    <a class="control" href="/photography/">
      Explore photography <span aria-hidden="true">↗</span>
    </a>
  </aside>
</BaseLayout>
