---
// ==========================================
// 🏠 HOMEPAGE & BLOG ARCHIVE (index.astro)
// ==========================================
// This is the front door of your website! When people visit
// https://neiltaylerfilm.com, this is the page they see.
// It fetches your published blog posts, displays the tag filter
// toolbar, and arranges your posts into neat magazine cards.

// Blog archive page.
// --- BORROWED TOOLS (Imports) ---
// BaseLayout: The master picture frame of the website, providing the shared header, navigation, and footer.
import BaseLayout from '../layouts/BaseLayout.astro';
// BlogCard: A neat little preview card for a single article, showing its photo, title, date, and excerpt.
import BlogCard from '../components/BlogCard.astro';
// FeedControls: The toolbar for filtering by tags and sorting by date.
import FeedControls from '../components/FeedControls.astro';
// posts & classifications: Helpers that fetch articles and collect secondary tags for the archive filter.
import { posts, classifications as getClassifications } from '../lib/content';

// 📚 Fetch all published articles (sorted newest first)
// Think of this like opening the filing cabinet and pulling out every finished article folder.
const allPosts = await posts();

// 🏷️ Find the secondary tags used across these articles.
const classifications = getClassifications(allPosts, 'tags');
---

{/* We wrap the entire page in BaseLayout, like putting our canvas inside an ornate picture frame. */}
<BaseLayout
  title="Blog"
  description="Blog posts by Neil Tayler on photography, film, post-production, technology and the things that catch his attention."
>
  {/* Restore saved Grid before first paint on wider screens; mobile remains List. */}
  <script is:inline slot="head">
    try {
      if (
        localStorage.getItem('neil-blog-view') === 'grid' &&
        !window.matchMedia('(max-width: 767px)').matches
      ) {
        document.documentElement.dataset.blogView = 'grid';
      }
    } catch {}
  </script>
  {/* The main stage for our blog articles. We give it an aria-label so screen readers describe it clearly to visually impaired visitors. */}
  <section class="content-start" aria-label="Blog articles">
    <div class="blog-archive-controls">
      {/* 🏷️ Top Section Heading: "Latest posts" */}
      {/* A decorative header with a small title and a stylish horizontal divider line. */}
      <div class="section-heading">
        <h1 class="eyebrow">Latest posts</h1>
        <span class="line-decoration" aria-hidden="true"></span>
      </div>

      {/* 🎛️ Filter dropdowns (Tags and Sort) */}
      {/* Show the tag filter and sorting controls when there are posts to display. */}
      {allPosts.length > 0 && (
        <div class="blog-control-row">
          <FeedControls
            options={classifications}
            count={allPosts.length}
            filterLabel="Tags"
            allLabel="All tags"
          />
          <div
            class="blog-view-toggle"
            role="group"
            aria-label="Blog view"
            data-blog-view-controls
            hidden
          >
            <button type="button" data-blog-view="list" aria-pressed="true">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <circle cx="3" cy="4" r="0.75" fill="currentColor" />
                <circle cx="3" cy="8" r="0.75" fill="currentColor" />
                <circle cx="3" cy="12" r="0.75" fill="currentColor" />
                <path d="M6 4h8M6 8h8M6 12h8" stroke="currentColor" stroke-linecap="round" />
              </svg>
              <span>List</span>
            </button>
            <button type="button" data-blog-view="grid" aria-pressed="false">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <rect x="2" y="2" width="5" height="5" rx="0.75" stroke="currentColor" />
                <rect x="9" y="2" width="5" height="5" rx="0.75" stroke="currentColor" />
                <rect x="2" y="9" width="5" height="5" rx="0.75" stroke="currentColor" />
                <rect x="9" y="9" width="5" height="5" rx="0.75" stroke="currentColor" />
              </svg>
              <span>Grid</span>
            </button>
          </div>
        </div>
      )}
    </div>

    {/* 📰 Grid list of blog cards */}
    {/* The magazine rack: a grid container holding all the blog article cards. */}
    <div class="blog-feed" data-feed data-blog-feed>
      {/* We loop through each post in our list like flipping through index cards, creating a neat preview card for each one. */}
      {allPosts.map((post, index) => (
        <BlogCard post={post} index={index} />
      ))}
    </div>

    {/* 🍃 Empty message if you haven't published anything yet */}
    {/* Question: Is the article list completely empty? If yes, show a gentle note so visitors know nothing is broken. */}
    {!allPosts.length && <p class="empty-state">No posts published yet.</p>}

    {/* 🏁 Friendly end marker when visitor reaches the bottom */}
    {/* When there are posts, we put a little signpost at the very end saying you've reached the bottom of the list. */}
    {allPosts.length > 0 && (
      <div class="end-note mono">
        <span aria-hidden="true">■</span> You’re all caught up. More when there’s more.
      </div>
    )}
  </section>

  <script>
    const controls = document.querySelector<HTMLElement>('[data-blog-view-controls]');
    const feed = document.querySelector<HTMLElement>('[data-blog-feed]');

    if (controls && feed) {
      const buttons = Array.from(
        controls.querySelectorAll<HTMLButtonElement>('button[data-blog-view]'),
      );
      const mobileViewport = window.matchMedia('(max-width: 767px)');
      let preferredView: 'list' | 'grid' = 'list';

      function setView(view: 'list' | 'grid', persist = false) {
        if (persist) preferredView = view;
        // Keep the saved preference for desktop, but present the archive as a list on mobile.
        const activeView = mobileViewport.matches ? 'list' : view;
        document.documentElement.dataset.blogView = activeView;

        for (const button of buttons) {
          button.setAttribute('aria-pressed', String(button.dataset.blogView === activeView));
        }

        if (persist) {
          try {
            localStorage.setItem('neil-blog-view', view);
          } catch {}
        }
      }

      let initialView: 'list' | 'grid' =
        document.documentElement.dataset.blogView === 'grid' ? 'grid' : 'list';
      try {
        const savedView = localStorage.getItem('neil-blog-view');
        if (savedView === 'list' || savedView === 'grid') initialView = savedView;
      } catch {}

      preferredView = initialView;
      setView(initialView);
      controls.hidden = false;
      mobileViewport.addEventListener('change', () => setView(preferredView));

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const view = button.dataset.blogView;
          if (view === 'list' || view === 'grid') setView(view, true);
        });
      }
    }
  </script>
</BaseLayout>
