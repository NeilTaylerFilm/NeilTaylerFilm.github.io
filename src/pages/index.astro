---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Welcome</h1>
				<p class="lead">
					This is my personal blog, where I write about technology, post-production, editing, colour grading, filmmaking, photography, and other interests.
				</p>
			</section>
			<section class="intro">
				<h2>Latest Writing</h2>
				<p>
					Check out my <a href="/blog/">writing</a> for thoughts and articles on topics I'm currently exploring.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 2em 1em;
	}
	.hero {
		text-align: center;
		padding: 3em 0;
	}
	.hero h1 {
		font-size: 2.5em;
		margin-bottom: 0.5em;
	}
	.lead {
		font-size: 1.25em;
		color: rgb(var(--gray-dark));
		max-width: 600px;
		margin: 0 auto;
	}
	.intro {
		margin-top: 3em;
		text-align: center;
	}
</style>
