---
// ==========================================
// 📬 CONTACT & GET IN TOUCH (contact.astro)
// ==========================================
// This is your contact hub! When people want to reach out to you,
// this page provides:
// - A 1-click "Copy email" button (with instant "Copied ✓" confirmation).
// - An "Email me ↗" button that opens their email client.
// - Direct links to your Instagram, LinkedIn, and TikTok profiles.

// Contact page with email and social links.
// --- BORROWED TOOLS (Imports) ---
// ContactIcon: Draws the matching symbol (like a little mail envelope, camera for Instagram, etc.).
import ContactIcon from '../components/ContactIcon.astro';
// BaseLayout: The shared website foundation (header bar, footer, styling).
import BaseLayout from '../layouts/BaseLayout.astro';
// site: Our website configuration file containing your email address and profile handles.
import { site } from '../config/site';

// 🔗 Filter for social links that have a valid URL filled in
// Like flipping through a business card Rolodex and discarding blank cards.
const links = site.links.filter((link) => link.url);
---

<BaseLayout
  title="Contact"
  description="Get in touch with Neil Tayler about photography, film, post-production or a blog post."
>
  {/* 🏷️ Page Header */}
  <div class="page-intro">
    <p class="eyebrow">Keep in touch</p>
    <h1>
      Contact<span class="accent">.</span>
    </h1>
  </div>

  <div class="contact-layout">
    {/* 💬 Friendly introduction note */}
    <div class="contact-intro">
      <h2>Say hello.</h2>
      <p>For a conversation about images, an idea, or something you’ve read here.</p>
    </div>

    {/* 📇 List of Contact Channels */}
    <div class="contact-list">
      {/* ✉️ Email Row with "Copy email" and "Email me" buttons */}
      {/* Question: Is an email address configured in site.email? If yes, show this contact row. */}
      {site.email && (
        <div class="contact-row">
          <strong>
            <ContactIcon name="Email" />
            Email
          </strong>
          <div class="contact-email-actions">
            {/* 📋 1-Click Copy Email Button */}
            {/* When clicked, the little script below slips the email onto the visitor's clipboard. */}
            <button
              class="control contact-copy-email"
              type="button"
              data-copy-email
              data-email={site.email}
              aria-label="Copy email address"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              <span data-copy-label>Copy email</span>
            </button>
            {/* ↗️ Standard mailto link */}
            {/* Clicking this opens the user's default email client (Apple Mail, Outlook, etc.). */}
            <a class="control contact-email" href={`mailto:${site.email}`}>
              Email me <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      )}
      {/* Invisible live region for screen readers */}
      {/* Sighted users don't see this, but when text is copied, assistive tech announces it out loud. */}
      <p class="visually-hidden" data-copy-status role="status" aria-live="polite"></p>

      {/* 🌐 Social Media Link Rows */}
      {/* We iterate over every social profile link, displaying its branded icon and user handle. */}
      {links.map((link) => (
        <a class="contact-row" href={link.url}>
          <strong>
            <ContactIcon name={link.label} />
            {link.label}
          </strong>
          <span>
            {link.username} <span aria-hidden="true">↗</span>
          </span>
        </a>
      ))}

      {/* Fallback if no contact details were provided */}
      {/* Question: Are both email and social links missing? If so, show a polite holding message. */}
      {!site.email && !links.length && (
        <p class="contact-row muted">Contact details will be added soon.</p>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  // 📋 CLIPBOARD COPY CONTROLLER:
  // Copies your email to the visitor's clipboard without navigating away
  // Grab references to the interactive elements on the page using their data- attributes.
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const label = document.querySelector<HTMLSpanElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  // Only attach the click listener if the button exists on this page.
  if (button) {
    button.addEventListener('click', async () => {
      try {
        // Ask the browser's clipboard to store the email string like putting a piece of paper in someone's pocket.
        await navigator.clipboard.writeText(button.dataset.email || '');
        const original = label?.textContent || 'Copy email';
        // Temporary success text
        label!.textContent = 'Copied ✓';
        status!.textContent = 'Email address copied to clipboard.';
        // Reset back to "Copy email" after 2 seconds
        setTimeout(() => {
          label!.textContent = original;
          status!.textContent = '';
        }, 2000);
      } catch {
        // If the browser blocks clipboard access, guide the user to select and copy manually.
        status!.textContent = 'Could not copy email address. Please select and copy it manually.';
      }
    });
  }
</script>

