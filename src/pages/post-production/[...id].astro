---
// ==========================================
// 🎬 INDIVIDUAL FILM PROJECT PAGE (post-production/[...id].astro)
// ==========================================
// This is the dedicated theater page for a specific film, music video, or VFX reel!
// It features:
// - Movie poster with click-to-play video player.
// - Project backstory and roles (Director, Editor, Colorist).
// - Behind-the-scenes photo stills gallery.
// - Direct links to related blog articles.

// Individual post-production project page with video embed and gallery.
// --- BORROWED TOOLS (Imports) ---
// render: Astro's Markdown compiler to turn the project's written backstory into HTML.
import { render } from 'astro:content';
// BaseLayout: The shared website frame (header bar, footer, styling).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleReader from '../../components/ArticleReader.astro';
import PlayIcon from '../../components/PlayIcon.astro';
// ProjectMetadata: Displays project tags like year, role (Director, Colorist), and client.
import ProjectMetadata from '../../components/ProjectMetadata.astro';
// Gallery: Displays behind-the-scenes photo stills.
import Gallery from '../../components/Gallery.astro';
// site: Global website configuration.
import { site } from '../../config/site';
// postProjects: Helper to fetch all film projects from disk.
import { isoDate, postProjects, posts } from '../../lib/content';

// 🗺️ ROUTE GENERATOR: Creates a webpage for each post-production project
// Tells Astro: "Look through our film shelf and create a dedicated theater page for each one!"
export async function getStaticPaths() {
  return (await postProjects()).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

// Unpack this project's metadata and render its written Markdown story
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const relatedPosts = data.relatedPosts.length
  ? (await posts()).filter((post) => data.relatedPosts.includes(post.id))
  : [];
const socialImage =
  data.socialImage ||
  data.poster ||
  data.coverImage ||
  data.cover ||
  data.images[0]?.src ||
  site.defaultImage;
const description =
  data.description || data.subtitle || `${data.title}: a post-production project by ${site.author}.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  articleSection: data.categories,
  description,
  ...(data.date ? { datePublished: isoDate(data.date) } : {}),
  author: {
    '@type': 'Person',
    name: site.author,
    url: new URL('/about/', Astro.site).href,
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(socialImage, Astro.site).href,
};
---

<BaseLayout
  title={data.title}
  description={description}
  image={socialImage}
  noindex={data.draft}
  article={true}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  ></script>
  {/* 🔙 Back to catalog link */}
  <a class="back-link mono" href="/post-production/" data-archive-back="/post-production/">
    ← All post-production
  </a>

  <article>
    <header class="article-header project-intro">
      <ProjectMetadata {...data} />
      <h1>
        {data.title}
        <span class="accent">.</span>
      </h1>
      {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
      <p class="byline mono">By {site.author}</p>
      {data.demo && <p class="demo-notice">Example project · This sample work is not Neil's.</p>}
    </header>

    {data.video && (
      <div class="article-hero project-video">
        <div class="video-container" data-video-container data-video-url={data.video}>
          <img
            src={data.poster || data.coverImage || data.cover}
            alt={data.title}
            class="video-poster"
            data-video-poster
          />
          <button class="video-play" data-video-play aria-label="Play video" type="button">
            <PlayIcon size={72} />
          </button>
          <p class="video-player-status" data-video-status role="status" aria-live="polite"></p>
          <a
            class="video-player-direct"
            data-video-direct
            href={data.video}
            target="_blank"
            rel="noopener noreferrer"
            hidden
          >Open video directly</a>
        </div>
      </div>
    )}

    <ArticleReader
      headings={headings}
      archiveHref="/post-production/"
      archiveLabel="Back to post-production"
    >
      <Content />
      {data.images.length > 0 && <Gallery slot="after" images={data.images} />}
    </ArticleReader>
  </article>

  {relatedPosts.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <div class="section-heading">
        <h2 id="related-heading" class="eyebrow">Related posts</h2>
        <span class="line-decoration" aria-hidden="true"></span>
      </div>
      <div class="related-grid">
        {relatedPosts.map((post) => (
          <article>
            <time class="mono small muted" datetime={isoDate(post.data.date)}>
              {isoDate(post.data.date)}
            </time>
            <h3>
              <a href={`/blog/${post.id}/`}>
                {post.data.title} <span class="accent" aria-hidden="true">→</span>
              </a>
            </h3>
          </article>
        ))}
      </div>
    </section>
  )}

  {/* 🏁 Polite sign-off at bottom */}
  <div class="project-end">
    <p class="serif-word">Thanks for looking.</p>
    <a class="control" href="/post-production/" data-archive-back="/post-production/">
      Back to the project index →
    </a>
  </div>
</BaseLayout>

<script>
  // 🔌 VIDEO EMBEDDER:
  // Waits until the visitor clicks the Play button before downloading YouTube/Vimeo
  // so the page loads at lightning speed!
  // Lazy-load video iframe on play click
  document.querySelectorAll<HTMLElement>('[data-video-container]').forEach((container) => {
    const playBtn = container.querySelector<HTMLButtonElement>('[data-video-play]');
    const playerStatus = container.querySelector<HTMLElement>('[data-video-status]')!;
    const directLink = container.querySelector<HTMLAnchorElement>('[data-video-direct]')!;
    if (!playBtn) return;
    let activeIframe: HTMLIFrameElement | undefined;

    // Attach click listener to load the video only when requested
    playBtn.addEventListener('click', () => {
      const videoUrl = (container as HTMLElement).dataset.videoUrl;
      if (!videoUrl) return;

      const { id, provider } = parseVideoUrl(videoUrl);
      if (!id) return;

      const isYouTube = provider === 'youtube';
      const embedUrl = isYouTube
        ? `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1`
        : `https://player.vimeo.com/video/${id}?title=0&byline=0&portrait=0`;

      const iframe = document.createElement('iframe');
      activeIframe?.remove();
      activeIframe = iframe;
      iframe.src = embedUrl;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'video-embed';
      iframe.title = 'Film player';
      directLink.href = isYouTube
        ? `https://www.youtube.com/watch?v=${id}`
        : `https://vimeo.com/${id}`;
      container.setAttribute('aria-busy', 'true');
      playerStatus.textContent = 'Loading player…';
      // If the embed takes too long (e.g. adblocker or slow network), show a direct link
      const timer = window.setTimeout(() => {
        if (iframe.isConnected && activeIframe === iframe) {
          playerStatus.textContent = 'Player is taking a while to load.';
          directLink.hidden = false;
        }
      }, 8000);
      iframe.addEventListener('load', () => {
        if (!iframe.isConnected || activeIframe !== iframe) return;
        window.clearTimeout(timer);
        container.removeAttribute('aria-busy');
        container.querySelector('[data-video-poster]')?.remove();
        playBtn.remove();
        playerStatus.textContent = '';
        directLink.hidden = true;
      }, { once: true });
      iframe.addEventListener('error', () => {
        if (activeIframe !== iframe) return;
        window.clearTimeout(timer);
        container.removeAttribute('aria-busy');
        playerStatus.textContent = 'Player could not load.';
        playBtn.hidden = false;
        directLink.hidden = false;
        iframe.remove();
      }, { once: true });

      playBtn.hidden = true;
      container.appendChild(iframe);
      iframe.focus();
    });
  });

  // 🔍 Helper to inspect video link and extract ID and whether it's YouTube or Vimeo
  // Takes a URL string, checks patterns for YouTube and Vimeo, and returns the ID
  function parseVideoUrl(url: string): { id: string | null; provider: 'youtube' | 'vimeo' | null } {
    if (!url) return { id: null, provider: null };

    const ytMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    if (ytMatch) return { id: ytMatch[1], provider: 'youtube' };

    const vmMatch = url.match(/vimeo\.com\/(\d+)/);
    if (vmMatch) return { id: vmMatch[1], provider: 'vimeo' };

    if (/^[a-zA-Z0-9_-]{11}$/.test(url)) return { id: url, provider: 'youtube' };
    if (/^\d+$/.test(url)) return { id: url, provider: 'vimeo' };

    return { id: null, provider: null };
  }
</script>

<style>
  /* 📺 16:9 widescreen movie frame aspect ratio */
  .video-container {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .video-poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Round play button floating in the dead center of the poster */
  .video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    padding: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    border: 0;
    color: white;
    cursor: pointer;
  }
  .video-player-status:not(:empty) {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    margin: 0;
    padding: 7px 10px;
    background: var(--surface);
    color: var(--text);
    font: 11px var(--mono);
    pointer-events: none;
  }
  .video-player-direct:not([hidden]) {
    position: absolute;
    z-index: 2;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 10px;
    background: var(--surface);
    color: var(--accent);
    font: 11px var(--mono);
  }
  /* On mobile phones, use 4:3 so video takes more vertical space */
  @media (max-width: 767px) {
    .video-container {
      aspect-ratio: 4 / 3;
    }
  }
</style>

