---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotographySlideshow from '../../components/PhotographySlideshow.astro';
import FeedControls from '../../components/FeedControls.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../lib/content';
const allProjects = await projects();
const categories = [...new Set(allProjects.map((p) => p.data.category))].sort();
---

<BaseLayout
  title="Photography"
  description="Photographs, collected into projects. A place to slow down and look."
>
  <h1 class="visually-hidden">Photography</h1>
  <PhotographySlideshow />
  <section class="project-section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <h2 id="projects-heading" class="eyebrow">
        The project index
      </h2>
      <span class="line-decoration" aria-hidden="true"></span>
    </div>
    <FeedControls categories={categories} count={allProjects.length} noun="projects" />
    <div class="project-grid" data-feed>
      {allProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    {!allProjects.length && <p class="empty-state">New projects are on their way.</p>}
  </section>
</BaseLayout>
