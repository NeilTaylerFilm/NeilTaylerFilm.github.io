---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotographyPortfolio from '../../components/PhotographyPortfolio.astro';
import FeedControls from '../../components/FeedControls.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, classifications as getClassifications } from '../../lib/content';

const allProjects = await projects();
const classifications = getClassifications(allProjects, 'category');
---

<BaseLayout
  title="Photography"
  description="Photographs, collected into projects. A place to slow down and look."
>
  <h1 class="visually-hidden">Photography</h1>
  <div class="photography-intro">
    {allProjects.length > 0 && (
      <a class="projects-shortcut mono" href="#projects-heading">
        View projects ↓
      </a>
    )}
    <PhotographyPortfolio />
  </div>

  <section class="project-section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <h2 id="projects-heading" class="eyebrow">
        The project index
      </h2>
      <span class="line-decoration" aria-hidden="true"></span>
    </div>
    {allProjects.length > 0 && (
      <FeedControls
        options={classifications}
        legacyFilterBy="type"
        count={allProjects.length}
        noun="projects"
      />
    )}
    <div class="project-grid" data-feed>
      {allProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    {!allProjects.length && <p class="empty-state">No projects published yet.</p>}
  </section>
</BaseLayout>

<style>
  .projects-shortcut {
    display: flex;
    width: fit-content;
    align-items: center;
    min-height: 44px;
    margin-left: auto;
    font-size: 12px;
  }
  .project-section {
    margin-top: 16px;
  }
</style>
