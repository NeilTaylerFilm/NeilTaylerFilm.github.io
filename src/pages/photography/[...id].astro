---
// ==========================================
// 📸 INDIVIDUAL PHOTO PROJECT ROOM (photography/[...id].astro)
// ==========================================
// This is the dedicated exhibition room for one specific photo album!
// For example, if you have an album named "japan-2024.md", this file builds
// the /photography/japan-2024/ webpage.
// It shows your album title, written introduction, full photo gallery wall,
// and the fullscreen zoom lightbox!

// Individual photography project page with gallery and lightbox.
// --- BORROWED TOOLS (Imports) ---
// render: Astro's Markdown reader to transform the project's text notes into HTML.
import { render } from 'astro:content';

// BaseLayout: Master page framework providing the navigation header and footer.
import BaseLayout from '../../layouts/BaseLayout.astro';
// ProjectMetadata: Displays project details like date, camera, and location pills.
import ProjectMetadata from '../../components/ProjectMetadata.astro';
// Lightbox: The full-screen zoom pop-up modal when you click a photograph.
import Lightbox from '../../components/Lightbox.astro';
// Gallery: The responsive wall of images arranged in editorial rows or masonry.
import Gallery from '../../components/Gallery.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RelatedContent from '../../components/RelatedContent.astro';
// site: Website configuration like the author's name and default images.
import { site } from '../../config/site';
// projects: Helper to fetch all published photo projects.
import { projects } from '../../lib/content';
import { relatedContentIndex, relatedContentKey } from '../../lib/related-content';
import { youtubeThumbnailUrl } from '../../lib/youtube';

// 🗺️ THE TOUR GUIDE (Dynamic Route Generator):
// Tells Astro to create a unique webpage for EVERY photo project in your folder!
export async function getStaticPaths() {
  const allProjects = await projects();
  const recommendations = relatedContentIndex(allProjects);
  return allProjects.map((project) => ({
    params: { id: project.id },
    props: {
      project,
      related: recommendations.get(relatedContentKey(project)) ?? [],
    },
  }));
}

// Unpack the current project's data and render its written Markdown story
const { project, related } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const firstMedia = data.images[0];
const galleryPreview =
  firstMedia?.type === 'video'
    ? firstMedia.poster || youtubeThumbnailUrl(firstMedia.videoId)
    : firstMedia?.src;
const photoCount = data.images.filter((media) => media.type !== 'video').length;
const videoCount = data.images.length - photoCount;
const mediaLabel =
  photoCount > 0 && videoCount > 0
    ? 'photographs and videos'
    : videoCount === 1
      ? 'video'
      : videoCount > 1
        ? 'videos'
        : photoCount === 1
          ? 'photograph'
          : 'photographs';
---

{/* The master website frame wrapping this project's gallery room */}
<BaseLayout
  title={data.title}
  description={
    data.description || data.subtitle || `${data.title}: a photography project by ${site.author}.`
  }
  image={data.socialImage || data.coverImage || data.cover || galleryPreview}
  noindex={data.draft}
>
  {/* 🔙 Back button (remembers previous filters) */}
  <a class="back-link mono" href="/photography/" data-archive-back="/photography/">
    ← All photography
  </a>

  {/* 📖 Album Introduction Header */}
  <header class="project-intro">
    {/* Metadata bar showing date, location, and camera gear */}
    <ProjectMetadata {...data} />
    <h1>
      {data.title}
      <span class="accent">.</span>
    </h1>
    {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
    {/* Optional notice if this project is sample demonstration content */}
    {data.demo && (
      <p class="demo-notice">Example project · These sample photographs are not Neil’s work.</p>
    )}
    {/* The written story / artist statement from your markdown */}
    <div class="prose project-description" data-project-prose>
      <Content />
    </div>
  </header>

  {/* 🧱 The photo gallery wall */}
  {/* Renders all photographs in this project with responsive sizing and layout */}
  <Gallery images={data.images} layout={data.galleryLayout} />

  {/* 🔍 The full-screen zoom pop-up widget */}
  {/* Listens for image clicks and opens a high-resolution lightbox viewer */}
  <Lightbox label={`${data.title} — ${mediaLabel}`} />

  <RelatedContent
    title="Related photography projects"
    headingId="related-photography-heading"
    items={related}
  >
    {related.map((relatedProject) => (
      <ProjectCard project={relatedProject} />
    ))}
  </RelatedContent>

  {/* 🏁 Polite sign-off at the end of the album */}
  <div class="project-end">
    <p class="serif-word">Thanks for looking.</p>
    <a class="control" href="/photography/" data-archive-back="/photography/">
      Back to the project index →
    </a>
  </div>
</BaseLayout>
