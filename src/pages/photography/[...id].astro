---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMetadata from '../../components/ProjectMetadata.astro';
import Lightbox from '../../components/Lightbox.astro';
import Gallery from '../../components/Gallery.astro';
import { site } from '../../config/site';
import { projects } from '../../lib/content';
export async function getStaticPaths() {
  return (await projects()).map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<BaseLayout
  title={data.title}
  description={
    data.description || data.subtitle || `${data.title}: a photography project by ${site.author}.`
  }
  image={data.socialImage || data.coverImage || data.cover}
  noindex={data.draft}
>
  <a class="back-link mono" href="/photography/" data-archive-back="/photography/">
    ← All photography
  </a>
  <header class="project-intro">
    <ProjectMetadata {...data} />
    <h1>
      {data.title}
      <span class="accent">.</span>
    </h1>
    {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
    {data.demo && (
      <p class="demo-notice">Example project · These sample photographs are not Neil’s work.</p>
    )}
    <div class="prose project-description" data-project-prose>
      <Content />
    </div>
    <p class="mono small muted">Select a frame to take a closer look</p>
  </header>
  <Gallery images={data.images} />
  <Lightbox title={data.title} />
  <div class="project-end">
    <p class="serif-word">Thanks for looking.</p>
    <a class="control" href="/photography/" data-archive-back="/photography/">
      Back to the project index →
    </a>
  </div>
</BaseLayout>
