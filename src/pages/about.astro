---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/about';
import { site } from '../config/site';
import ResponsiveImage from '../components/ResponsiveImage.astro';
---

<BaseLayout
  title="About"
  description={`A little about ${site.author}, photography and working in film and post-production.`}
>
  <div class="page-intro">
    <h1>
      A little <span class="serif-word">context.</span>
    </h1>
  </div>
  <div class="about-grid about-with-portrait">
    {about.portrait ? (
      <figure class="about-photo">
        <ResponsiveImage
          src={about.portrait}
          alt={about.portraitAlt}
          sizes="(max-width: 767px) 90vw, (max-width: 1440px) 40vw, 540px"
          loading="eager"
        />
      </figure>
    ) : (
      <figure class="about-photo">
        <div class="about-portrait-placeholder" role="img" aria-label="Portrait placeholder">
          <svg
            width="48"
            height="48"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="42" height="42" />
            <circle cx="24" cy="18" r="7" />
            <path d="M11 40c0-9 5-14 13-14s13 5 13 14" />
          </svg>
          <p class="mono">Portrait to come</p>
        </div>
      </figure>
    )}
    <section class="about-copy">
      <h2>{about.heading}</h2>
      <div class="prose">
        {about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      {about.areas.length > 0 && (
        <div class="areas" role="group" aria-label="Areas of work">
          {about.areas.map((area) => (
            <span>{area}</span>
          ))}
        </div>
      )}
      <a class="control" href="/contact/">
        Let’s talk <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .about-with-portrait {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  }
  .about-photo {
    min-width: 0;
  }
  .about-portrait-placeholder {
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .about-with-portrait {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .about-photo {
      width: min(100%, 480px);
    }
  }
</style>
