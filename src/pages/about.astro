---
// ==========================================
// 🙋 ABOUT ME PAGE (about.astro)
// ==========================================
// This is your biography page! When visitors click "About",
// this page pulls in your bio text, portrait photo, and creative tags
// from src/data/about.ts, presenting them side-by-side in a stylish layout.

// About page with portrait and bio.
// --- BORROWED TOOLS (Imports) ---
// BaseLayout: The outer website framework (navigation bar at top, copyright footer at bottom).
import BaseLayout from '../layouts/BaseLayout.astro';
// about: Our biography information sheet (paragraphs, portrait image link, skills) stored in src/data/about.ts.
import { about } from '../data/about';
// site: General website settings (like the author's name "Neil Tayler") from src/config/site.ts.
import { site } from '../config/site';
// ResponsiveImage: A clever picture frame that serves the right image size so mobile phones don't download giant files.
import ResponsiveImage from '../components/ResponsiveImage.astro';
---

<BaseLayout
  title="About"
  description={`A little about ${site.author}, photography and working in film and post-production.`}
>
  {/* 🏷️ Top Page Title */}
  <div class="page-intro">
    <h1>
      A little <span class="serif-word">context.</span>
    </h1>
  </div>

  {/* 🖼️ Two-Column Layout: Portrait on the left, Bio story on the right */}
  <div class="about-grid about-with-portrait">
    {/* 📷 LEFT COLUMN: Show real portrait photo or show the placeholder graphic */}
    {/* Question: Has Neil added a portrait photo path in src/data/about.ts?
        - If YES: Show the optimized ResponsiveImage right away (loading="eager" so it appears without delay).
        - If NO: Show a friendly minimalist sketch box saying "Portrait to come" so the layout stays balanced. */}
    {about.portrait ? (
      <figure class="about-photo">
        <ResponsiveImage
          src={about.portrait}
          alt={about.portraitAlt}
          sizes="(max-width: 767px) 90vw, (max-width: 1440px) 40vw, 540px"
          loading="eager"
        />
      </figure>
    ) : (
      <figure class="about-photo">
        <div class="about-portrait-placeholder" role="img" aria-label="Portrait placeholder">
          <svg
            width="48"
            height="48"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="42" height="42" />
            <circle cx="24" cy="18" r="7" />
            <path d="M11 40c0-9 5-14 13-14s13 5 13 14" />
          </svg>
          <p class="mono">Portrait to come</p>
        </div>
      </figure>
    )}

    {/* 📖 RIGHT COLUMN: Biography text & Call to action button */}
    {/* This section holds the written story, skills list, and a direct link to get in touch. */}
    <section class="about-copy">
      <h2>{about.heading}</h2>
      {/* We loop through each paragraph in our biography list and wrap it in a <p> tag so it reads nicely. */}
      <div class="prose">
        {about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      {/* 🏷️ Discipline pill tags (e.g. Photography, Film, Post-production) */}
      {/* Question: Are there any skill areas listed in about.areas? If yes, show them as badge pills. */}
      {about.areas.length > 0 && (
        <div class="areas" role="group" aria-label="Areas of work">
          {about.areas.map((area) => (
            <span>{area}</span>
          ))}
        </div>
      )}

      {/* 📬 "Let's talk →" button linking directly to the Contact page */}
      <a class="control" href="/contact/">
        Let’s talk <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  /* 📐 Split layout: Photo gets 1 share of space, text gets 1.15 shares so it feels roomier */
  .about-with-portrait {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  }
  /* Prevents large photos from accidentally pushing the grid wider than the screen */
  .about-photo {
    min-width: 0;
  }
  /* The fallback placeholder box styling: nice 4:5 vertical proportions with a centered icon */
  .about-portrait-placeholder {
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
  }
  /* 📱 Phone screens: Switch from side-by-side to stacked columns so photos and text fit neatly */
  @media (max-width: 767px) {
    .about-with-portrait {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .about-photo {
      width: min(100%, 480px);
    }
  }
</style>

