---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/about';
import { site } from '../config/site';
import ResponsiveImage from '../components/ResponsiveImage.astro';
---

<BaseLayout
  title="About"
  description={`A little about ${site.author}, photography and working in film and post-production.`}
>
  <div class="page-intro">
    <h1>
      A little <span class="serif-word">context.</span>
    </h1>
  </div>
  <div class:list={['about-grid', { 'without-portrait': !about.portrait }]}>
    {about.portrait && (
      <figure class="about-photo">
        <ResponsiveImage
          src={about.portrait}
          alt={about.portraitAlt}
          width={800}
          height={1000}
          sizes="(max-width: 540px) 90vw, 40vw"
          loading="eager"
        />
      </figure>
    )}
    <section class="about-copy">
      <h2>{about.heading}</h2>
      <div class="prose">
        {about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      {about.areas.length > 0 && (
        <div class="areas" role="group" aria-label="Areas of work">
          {about.areas.map((area) => (
            <span>{area}</span>
          ))}
        </div>
      )}
      <a class="control" href="/contact/">
        Let’s talk <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>
