---
// ==========================================
// 📰 INDIVIDUAL BLOG ARTICLE (blog/[...id].astro)
// ==========================================
// This is the reader view for a single blog post!
// It features:
// - Top reading progress bar that fills up as you scroll down.
// - Chapter navigation outline for long essays.
// - Clickable citation links and footnotes.
// - Related articles list at the bottom.
// - Structured SEO data so search engines understand the article.

import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { posts, isoDate, excerpt } from '../../lib/content';
import { imageInfo } from '../../lib/images';
import { categoryKey } from '../../lib/feed';
import { site } from '../../config/site';

// 🗺️ ROUTE GENERATOR: Creates a webpage for each blog post file
export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

// 📦 Extract current article data and Markdown body renderer
const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

// 📑 Build chapter outline from H2 through H6 headings
const chapters = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 6);
const minChapterDepth = Math.min(...chapters.map((chapter) => chapter.depth));

// 🔗 Find up to 3 related articles sharing matching categories
const related = (await posts())
  .filter(
    (p) =>
      p.id !== post.id &&
      p.data.categories.some((category) =>
        data.categories.some((own) => categoryKey(own) === categoryKey(category)),
      ),
  )
  .slice(0, 3);

// 🖼️ Pick social sharing card image
const socialImage = data.socialImage || data.image || site.defaultImage;

// 🔍 Structured Schema.org data for Google search indexing
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  articleSection: data.categories,
  description: data.description || excerpt(post.body, data.excerpt),
  datePublished: isoDate(data.date),
  dateModified: isoDate(data.updated || data.date),
  author: { '@type': 'Person', name: site.author, url: new URL('/about/', Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(imageInfo(socialImage)?.src || socialImage, Astro.site).href,
};
---

<BaseLayout
  title={data.title}
  description={data.description || excerpt(post.body, data.excerpt)}
  image={data.socialImage || data.image}
  noindex={data.draft}
  article={true}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  ></script>
  <div class="reading-progress" aria-hidden="true">
    <span data-reading-progress></span>
  </div>
  <a class="back-link mono" href="/" data-archive-back="/">
    ← Back to blog
  </a>
  <article>
    <header class="article-header">
      <div class="metadata">
        <span class="category">{data.categories.join(' / ')}</span>
        <span>/</span>
        <time datetime={isoDate(data.date)}>{isoDate(data.date)}</time>
      </div>
      <h1>{data.title}</h1>
      {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
      {data.updated && isoDate(data.updated) !== isoDate(data.date) && (
        <p class="mono muted">
          Updated <time datetime={isoDate(data.updated)}>{isoDate(data.updated)}</time>
        </p>
      )}
      <p class="byline mono">By {site.author}</p>
      {data.demo && (
        <p class="demo-notice">
          Example article · Demonstration copy, ready to replace with your own writing.
        </p>
      )}
    </header>
    {data.image && (
      <figure class="article-hero">
        <ResponsiveImage
          src={data.image}
          alt={data.imageAlt}
          sizes="(max-width: 1200px) 90vw, 1100px"
          loading="eager"
          priority={true}
        />
      </figure>
    )}
    <div class="article-reading-layout">
      {chapters.length >= 2 && (
        <nav class="chapter-nav chapter-nav-desktop" aria-label="Chapters">
          <p class="eyebrow">Chapters</p>
          <ol>
            {chapters.map((chapter) => (
              <li style={`padding-left: ${(chapter.depth - minChapterDepth) * 12}px`}>
                <a href={`#${chapter.slug}`}>{chapter.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      {chapters.length >= 2 && (
        <details class="chapter-nav chapter-nav-mobile">
          <summary class="mono">
            <span class="chapter-label">Chapters</span>
          </summary>
          <nav aria-label="Chapters">
            <ol>
              {chapters.map((chapter) => (
                <li style={`padding-left: ${(chapter.depth - minChapterDepth) * 12}px`}>
                  <a href={`#${chapter.slug}`}>{chapter.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
      {chapters.length >= 2 && (
        <button
          class="chapter-dimmer"
          data-chapter-dimmer
          type="button"
          aria-label="Close chapter menu"
          hidden
        ></button>
      )}
      <div class="prose article-body" data-article-body>
        <Content />
      </div>
      <div class="article-signoff mono">
        <span aria-hidden="true">■</span> End of entry{' '}
        <a href="/" data-archive-back="/">
          Back to blog →
        </a>
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <div class="section-heading">
        <h2 id="related-heading" class="eyebrow">
          Related posts
        </h2>
        <span class="line-decoration" aria-hidden="true"></span>
      </div>
      <div class="related-grid">
        {related.map((p) => (
          <article>
            <time class="mono small muted" datetime={isoDate(p.data.date)}>
              {isoDate(p.data.date)}
            </time>
            <h3>
              <a href={`/blog/${p.id}/`}>
                {p.data.title}{' '}
                <span class="accent" aria-hidden="true">
                  →
                </span>
              </a>
            </h3>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
<script>
  const body = document.querySelector<HTMLElement>('[data-article-body]');
  let updateProgress = () => {};
  let updateChapter = () => {};
  const openHashTarget = (hash = location.hash) => {
    let id = hash.slice(1);
    try {
      id = decodeURIComponent(id);
    } catch {}
    const target = id ? document.getElementById(id) : null;
    if (!target || !body?.contains(target)) return target;
    for (let parent = target.parentElement; parent && parent !== body; parent = parent.parentElement)
      if (parent instanceof HTMLDetailsElement) parent.open = true;
    return target;
  };
  if (body) {
    const bindCitationIcons = (root: ParentNode) => {
      for (const icon of root.querySelectorAll<HTMLImageElement>(
        'img[data-citation-icon]',
      )) {
        const hideBrokenIcon = () => (icon.hidden = true);
        if (icon.complete && !icon.naturalWidth) hideBrokenIcon();
        icon.addEventListener('error', hideBrokenIcon, { once: true });
      }
    };
    bindCitationIcons(body);

    const citationRuns: { parent: Node; nodes: Node[]; links: HTMLAnchorElement[] }[] = [];
    const isCitation = (node: Node) =>
      node instanceof HTMLAnchorElement && node.matches('a[title="cite"]');
    const isWhitespace = (node: Node) =>
      node.nodeType === Node.TEXT_NODE && !node.textContent?.trim();
    for (const paragraph of body.querySelectorAll('p')) {
      const nodes = [...paragraph.childNodes];
      for (let index = 0; index < nodes.length; ) {
        if (!isCitation(nodes[index])) {
          index++;
          continue;
        }
        const links = [nodes[index] as HTMLAnchorElement];
        let end = index + 1;
        while (end + 1 < nodes.length && isWhitespace(nodes[end]) && isCitation(nodes[end + 1])) {
          links.push(nodes[end + 1] as HTMLAnchorElement);
          end += 2;
        }
        if (links.length >= 3) citationRuns.push({ parent: paragraph, nodes: nodes.slice(index, end), links });
        index = end;
      }
    }
    const groups: HTMLDetailsElement[] = [];
    for (const run of citationRuns.reverse()) {
      const cluster = document.createElement('span');
      cluster.className = 'citation-cluster';
      const disclosure = document.createElement('details');
      disclosure.className = 'citation-more';
      disclosure.name = 'citation-sources';
      const summary = document.createElement('summary');
      const count = document.createElement('span');
      count.className = 'citation-count';
      count.textContent = `+${run.links.length - 1}`;
      for (const child of [...run.links[0].childNodes]) summary.append(child.cloneNode(true));
      summary.append(count);
      summary.setAttribute('aria-label', `View all ${run.links.length} cited sources`);
      const list = document.createElement('ul');
      list.className = 'citation-source-list';
      list.setAttribute('aria-label', 'All cited sources');
      for (const link of run.links) {
        const item = document.createElement('li');
        const source = link.cloneNode(true) as HTMLAnchorElement;
        item.append(source);
        list.append(item);
      }
      summary.addEventListener('click', () => {
        list.removeAttribute('data-positioned');
        requestAnimationFrame(() => {
          if (!disclosure.open) return;
          const anchor = summary.getBoundingClientRect();
          const width = list.getBoundingClientRect().width;
          const left = Math.max(16, Math.min(anchor.left, innerWidth - width - 16));
          const height = list.getBoundingClientRect().height;
          let top = anchor.bottom + 6;
          if (top + height > innerHeight - 16) top = Math.max(16, anchor.top - height - 6);
          list.style.left = `${left}px`;
          list.style.top = `${top}px`;
          list.setAttribute('data-positioned', '');
        });
      });
      disclosure.append(summary, list);
      bindCitationIcons(summary);
      bindCitationIcons(list);
      run.parent.insertBefore(cluster, run.nodes[0]);
      run.nodes.forEach((node) => node.parentNode?.removeChild(node));
      cluster.append(disclosure);
      groups.push(disclosure);
    }
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const open = groups.find((details) => details.open);
      if (!open) return;
      open.open = false;
      open.querySelector('summary')?.focus();
    });
    document.addEventListener('pointerdown', (event) => {
      const target = event.target;
      for (const details of groups)
        if (details.open && target instanceof Node && !details.contains(target)) details.open = false;
    });
    window.addEventListener('scroll', () => groups.forEach((details) => (details.open = false)), {
      passive: true,
    });
    window.addEventListener('resize', () => groups.forEach((details) => (details.open = false)));
    const sections: HTMLDetailsElement[] = [];
    const parents: { depth: number; details: HTMLDetailsElement }[] = [];
    for (const node of [...body.childNodes]) {
      const depth = node instanceof HTMLElement && /^H[2-6]$/.test(node.tagName)
        ? Number(node.tagName[1])
        : 0;
      if (depth) {
        while (parents.length && parents.at(-1)!.depth >= depth) parents.pop();
        const heading = node as HTMLElement;
        const details = document.createElement('details');
        details.className = 'article-section';
        details.open = !/^tl\s*;?\s*dr\b/i.test(heading.textContent?.trim() || '');
        const summary = document.createElement('summary');
        summary.append(heading);
        details.append(summary);
        (parents.at(-1)?.details || body).append(details);
        parents.push({ depth, details });
        sections.push(details);
      } else {
        (parents.at(-1)?.details || body).append(node);
      }
    }
    openHashTarget();
    window.addEventListener('hashchange', () => openHashTarget()?.scrollIntoView());
    for (const section of sections) section.addEventListener('toggle', () => {
      requestAnimationFrame(() => {
        updateProgress?.();
        updateChapter?.();
      });
    });
  }
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  if (body && bar) {
    let scheduled = false;
    const update = () => {
      const rect = body.getBoundingClientRect();
      const progress = Math.min(
        1,
        Math.max(0, scrollY / Math.max(1, scrollY + rect.bottom - innerHeight)),
      );
      bar.style.transform = `scaleX(${progress})`;
      scheduled = false;
    };
    updateProgress = update;
    window.addEventListener(
      'scroll',
      () => {
        if (!scheduled) {
          scheduled = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }

  const chapterLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>('.chapter-nav a[href^="#"]'),
  ];
  const headings = [...document.querySelectorAll<HTMLElement>('[data-article-body] :is(h2,h3,h4,h5,h6)[id]')];
  if (chapterLinks.length && headings.length) {
    chapterLinks.forEach((link) => link.addEventListener('click', (event) => {
      const target = openHashTarget(link.hash);
      if (!target || !body?.contains(target)) return;
      event.preventDefault();
      const mobileMenu = link.closest<HTMLDetailsElement>('.chapter-nav-mobile');
      if (mobileMenu) {
        mobileMenu.open = false;
        const dimmer = document.querySelector<HTMLButtonElement>('[data-chapter-dimmer]');
        if (dimmer) dimmer.hidden = true;
        mobileMenu.querySelector('summary')?.focus({ preventScroll: true });
      }
      if (location.hash === link.hash) target.scrollIntoView();
      else location.hash = link.hash;
    }));
    let scheduled = false;
    updateChapter = () => {
      const visibleHeadings = headings.filter((heading) => {
        return !heading.closest('details.article-section')?.parentElement
          ?.closest('details.article-section:not([open])');
      });
      const threshold = scrollY + 160;
      let active = visibleHeadings[0];
      for (const heading of visibleHeadings) {
        if (heading.getBoundingClientRect().top + scrollY > threshold) break;
        active = heading;
      }
      if (!active) {
        chapterLinks.forEach((link) => link.removeAttribute('aria-current'));
        scheduled = false;
        return;
      }
      chapterLinks.forEach((link) => {
        if (link.getAttribute('href') === `#${active.id}`)
          link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      scheduled = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!scheduled) {
          scheduled = true;
          requestAnimationFrame(updateChapter);
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', updateChapter);
    updateChapter();

    const mobileMenu = document.querySelector<HTMLDetailsElement>('.chapter-nav-mobile');
    const dimmer = document.querySelector<HTMLButtonElement>('[data-chapter-dimmer]');
    mobileMenu?.addEventListener('toggle', () => {
      if (dimmer) dimmer.hidden = !mobileMenu.open;
    });
    dimmer?.addEventListener('click', () => {
      if (!mobileMenu) return;
      mobileMenu.open = false;
      dimmer.hidden = true;
      mobileMenu.querySelector('summary')?.focus({ preventScroll: true });
    });
    mobileMenu?.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      mobileMenu.open = false;
      if (dimmer) dimmer.hidden = true;
      mobileMenu.querySelector('summary')?.focus({ preventScroll: true });
    });
  }
</script>
