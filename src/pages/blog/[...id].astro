---
// ==========================================
// 📰 INDIVIDUAL BLOG ARTICLE (blog/[...id].astro)
// ==========================================
// This is the reader view for a single blog post!
// It features:
// - Top reading progress bar that fills up as you scroll down.
// - Chapter navigation outline for long essays.
// - Clickable citation links and footnotes.
// - Related articles list at the bottom.
// - Structured SEO data so search engines understand the article.

// --- BORROWED TOOLS (Imports) ---
// render: Astro's Markdown engine that turns raw article text into rich HTML.
import { render } from 'astro:content';
// BaseLayout: The outer website framework (navbar, footer, SEO tags).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleReader from '../../components/ArticleReader.astro';
// ResponsiveImage: An image loader that serves properly sized pictures.
import ResponsiveImage from '../../components/ResponsiveImage.astro';
// posts, isoDate, excerpt: Content helpers for getting articles, clean dates, and short summaries.
import { posts, isoDate, excerpt } from '../../lib/content';
// imageInfo: Helper to find picture dimensions and paths.
import { imageInfo } from '../../lib/images';
// categoryKey: Normalizes category names like "Post-Production" to match consistently.
import { categoryKey, displayLabel, filterValues } from '../../lib/feed';
// site: Global website info like the author's name and default social image.
import { site } from '../../config/site';

// 🗺️ ROUTE GENERATOR: Creates a webpage for each blog post file
// Astro calls this during build time: "Make a page for every single article in our blog drawer!"
export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}

// 📦 Extract current article data and Markdown body renderer
// Grab this specific post's metadata and render its headings and content.
const { post } = Astro.props;
const { data } = post;
// Primary category pill + first secondary tag shown in the article header
const label = displayLabel(data);
const { Content, headings } = await render(post);

// 🔗 Find up to 3 existing same-section suggestions sharing a category or tag.
// This pre-existing Blog behavior is separate from the paused universal recommendation feature.
const ownTags = new Set(filterValues(data, 'tags').map(categoryKey));
const related = (await posts())
  .filter(
    (p) =>
      p.id !== post.id &&
      filterValues(p.data, 'tags').some((value) => ownTags.has(categoryKey(value))),
  )
  .slice(0, 3);

// 🖼️ Pick social sharing card image
// Chooses the best picture to show when this article is shared on iMessage, Twitter, or Slack.
const socialImage = data.socialImage || data.coverImage || data.image || site.defaultImage;

// 🔍 Structured Schema.org data for Google search indexing
// A tidy digital index card for search engine robots telling them who wrote this and when.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  // Preserve the previous topic-oriented structured data; those values now live in tags.
  articleSection: data.tags,
  description: data.description || excerpt(post.body, data.excerpt),
  datePublished: isoDate(data.date),
  dateModified: isoDate(data.updated || data.date),
  author: { '@type': 'Person', name: site.author, url: new URL('/about/', Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(imageInfo(socialImage)?.src || socialImage, Astro.site).href,
};
---

{/* Master frame wrapping this article page. */}
<BaseLayout
  title={data.title}
  description={data.description || excerpt(post.body, data.excerpt)}
  image={data.socialImage || data.coverImage || data.image}
  noindex={data.draft}
  article={true}
>
  {/* Injects JSON-LD search engine metadata into the <head> tag. */}
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  ></script>
  {/* Back link returning to the blog archive list. */}
  <a class="back-link mono" href="/" data-archive-back="/">
    ← Back to blog
  </a>
  <article>
    {/* Article header: displays primary category, first tag, publication date, title, and author. */}
    <header class="article-header">
      <div class="metadata">
        {label.category && <span class="category-pill">{label.category}</span>}
        {label.tag && <span class="tag-label">{label.tag}</span>}
        <time datetime={isoDate(data.date)}>{isoDate(data.date)}</time>
      </div>
      <h1>{data.title}</h1>
      {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
      {/* Question: Was this post updated after its original publish date? If so, show the update timestamp. */}
      {data.updated && isoDate(data.updated) !== isoDate(data.date) && (
        <p class="mono muted">
          Updated <time datetime={isoDate(data.updated)}>{isoDate(data.updated)}</time>
        </p>
      )}
      <p class="byline mono">By {site.author}</p>
      {data.demo && (
        <p class="demo-notice">
          Example article · Demonstration copy, ready to replace with your own writing.
        </p>
      )}
    </header>
    {/* Hero image: High-priority banner photo shown at the top of the article. */}
    {data.image && (
      <figure class="article-hero">
        <ResponsiveImage
          src={data.image}
          alt={data.imageAlt}
          sizes="(max-width: 1200px) 90vw, 1100px"
          loading="eager"
          priority={true}
        />
      </figure>
    )}
    <ArticleReader headings={headings} archiveHref="/" archiveLabel="Back to blog">
      <Content />
    </ArticleReader>
  </article>
  {/* Related articles shelf: Suggests up to 3 similar stories sharing the same topics. */}
  {related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <div class="section-heading">
        <h2 id="related-heading" class="eyebrow">
          Related posts
        </h2>
        <span class="line-decoration" aria-hidden="true"></span>
      </div>
      <div class="related-grid">
        {related.map((p) => (
          <article>
            <time class="mono small muted" datetime={isoDate(p.data.date)}>
              {isoDate(p.data.date)}
            </time>
            <h3>
              <a href={`/blog/${p.id}/`}>
                {p.data.title}{' '}
                <span class="accent" aria-hidden="true">
                  →
                </span>
              </a>
            </h3>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
